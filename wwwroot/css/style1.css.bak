/* Styles de base pour la table */
.table {
    width: 100%;
    border-collapse: collapse; /* Éviter que les bordures se chevauchent */
    margin-bottom: 20px;
    table-layout: fixed; /* Force les colonnes à avoir une largeur fixe mais ajustée en fonction du contenu */
}

.table th, .table td {
    padding: 10px;
    text-align: left;
    border: 1px solid #ddd; /* Bordure autour de chaque cellule */
    font-size: 14px; /* Taille de la police */
    word-wrap: break-word; /* Permet de couper les mots longs sur plusieurs lignes */
    white-space: normal; /* Autorise les retours à la ligne */
    overflow-wrap: break-word; /* Assure la coupe des mots longs dans le texte */
}

/* En-tête de la table */
.table th {
    background-color: #f8f9fa;
    word-wrap: break-word; /* Autoriser les retours à la ligne dans les titres */
}

/* Styles pour le bouton */
.btn {
    display: inline-block;
    padding: 10px 15px;
    text-decoration: none;
    border-radius: 5px;
    color: white;
    background-color: #007bff;
    border: none;
}

.btn:hover {
    background-color: #0056b3;
}

/* Table responsive pour les écrans mobiles */
@media screen and (max-width: 768px) {
    /* Réduire les espacements et la taille des cellules sur mobile */
    .table th, .table td {
        padding: 8px; /* Réduire les espacements pour plus de lisibilité */
        font-size: 12px; /* Taille de la police plus petite pour mobile */
        word-wrap: break-word; /* Permet de casser les mots longs */
        white-space: normal; /* Assure que le texte peut passer à la ligne */
        overflow-wrap: break-word; /* Assure la coupe des mots longs dans le texte */
    }

    /* Appliquer un style pour les bordures */
    .table, .table th, .table td {
        border: 1px solid #ddd; /* Bordure autour de chaque cellule */
    }

    /* Empêcher la table d'avoir un débordement horizontal */
    .table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    /* Affichage des boutons */
    .btn {
        width: 100%; /* Utiliser toute la largeur sur mobile */
        text-align: center;
        margin-top: 10px;
    }
}