<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Gestion LRR</title>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    
    <style>
        /* --- CONFIGURATION DE LA POLICE INTER INTERNE (NOMS RÉELS) --- */
        @@font-face {
            font-family: 'Inter';
            src: url('/css/fonts/inter-latin-400-normal.woff2') format('woff2');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }

        @@font-face {
            font-family: 'Inter';
            src: url('/css/fonts/inter-latin-700-normal.woff2') format('woff2');
            font-weight: 700;
            font-style: normal;
            font-display: swap;
        }

        /* --- VARIABLES DE DESIGN --- */
        :root {
            --primary-color: #4f46e5;       /* Indigo moderne */
            --primary-hover: #4338ca;
            --dark-surface: #0f172a;        /* Ardoise foncé professionnel */
            --bg-body: #f8fafc;              /* Gris très doux contemporain */
            --text-main: #1e293b;
            --radius-md: 8px;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.08), 0 2px 4px -1px rgba(0,0,0,0.04);

            /* --- COULEURS DYNAMIQUES PAR DÉFAUT (Modifiées par le script hors-ligne) --- */
            --dynamic-bg: #0f172a;
            --dynamic-text: #ffffff;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* --- HEADER ACCORDÉ À LA COULEUR ALÉATOIRE --- */
        .header-banner {
            background-color: var(--dynamic-bg) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            transition: background-color 0.4s ease, color 0.4s ease;
        }
        
        .header-banner h1 {
            color: var(--dynamic-text) !important;
        }

        /* --- NAVBAR ACCORDÉE À LA COULEUR ALÉATOIRE --- */
        .navbar-custom {
            background-color: var(--dynamic-bg) !important;
            box-shadow: var(--shadow-sm);
            padding: 0.6rem 1rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08); /* Fine ligne de séparation avec le header */
            transition: background-color 0.4s ease;
        }

        /* Adaptation dynamique de la couleur des liens de la navbar */
        .navbar-custom .nav-link {
            color: var(--dynamic-text) !important;
            opacity: 0.8; /* Légèrement estompé par défaut */
            font-weight: 500;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .navbar-custom .nav-link:hover,
        .navbar-custom .nav-item.show .nav-link {
            opacity: 1 !important; /* Éclairé au survol ou focus */
        }

        /* Menu Déroulant Élégant */
        .dropdown-menu {
            border: 1px solid #e2e8f0;
            box-shadow: var(--shadow-md);
            border-radius: var(--radius-md);
            padding: 0.5rem;
            animation: fadeIn 0.2s ease;
        }

        .dropdown-item {
            border-radius: 6px;
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            color: #334155;
            font-weight: 500;
            transition: all 0.15s ease;
        }

        .dropdown-item:hover {
            background-color: #f1f5f9;
            color: var(--primary-color);
            transform: translateX(3px);
        }

        /* AFFICHAGE DES CLOCHES ET DES LISTES */
        .dropdown-wide {
            width: 320px;
            max-height: 380px;
            overflow-y: auto;
        }
        .badge-notify {
            font-size: 0.65rem;
            padding: 0.25rem 0.45rem;
            border-radius: 50rem;
            position: absolute;
            top: 2px;
            right: -2px;
        }
        .notification-item-text {
            white-space: normal;
            font-size: 0.85rem;
            line-height: 1.35;
            border-bottom: 1px dashed #f1f5f9;
            padding-bottom: 0.5rem;
        }
        .notification-item-text:last-child {
            border-bottom: none;
        }

        /* --- CONTENEUR DE CONTENU PRINCIPAL --- */
        .main-content {
            flex: 1 0 auto;
            width: 100%;
            padding: 1.5rem 0;
        }

        /* --- FOOTER ÉLÉGANT ACCORDÉ AU RESTE --- */
        footer {
            flex-shrink: 0;
            text-align: center;
            padding: 1.5rem;
            background-color: var(--dynamic-bg) !important;
            color: var(--dynamic-text) !important;
            font-size: 0.85rem;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
            font-weight: 500;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        /* Animation d'affichage des menus */
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <script>
        (function () {
            // Liste locale (Hors-ligne) de thèmes [Fond / Texte] bien contrastés et professionnels
            const themes = [
                { bg: '#0f172a', text: '#f8fafc' }, // Ardoise Sombre / Blanc Cassé
                { bg: '#312e81', text: '#ffffff' }, // Indigo Royal / Blanc
                { bg: '#1e3a8a', text: '#ffffff' }, // Bleu Institutionnel / Blanc
                { bg: '#064e3b', text: '#f0fdf4' }, // Vert Forêt / Vert Très Clair
                { bg: '#581c87', text: '#fdf4ff' }, // Byzantium / Violet Très Clair
                { bg: '#451a03', text: '#fff7ed' }, // Brun Chaud Riche / Ambre Clair
               { bg: '#1e272e', text: '#f1f5f9' }, // REMPLACÉ : Noir Charbon / Gris Très Clair
               { bg: '#0f3443', text: '#e6f4f8' }, // REMPLACÉ : Bleu Canard Profond / Cyan Givré
                { bg: '#2e1065', text: '#f5f3ff' }  // Violet Nuit Obscur / Blanc
            ];

            let savedBg = sessionStorage.getItem('lrr_theme_bg');
            let savedText = sessionStorage.getItem('lrr_theme_text');

            if (!savedBg || !savedText) {
                const randomTheme = themes[Math.floor(Math.random() * themes.length)];
                savedBg = randomTheme.bg;
                savedText = randomTheme.text;
                
                sessionStorage.setItem('lrr_theme_bg', savedBg);
                sessionStorage.setItem('lrr_theme_text', savedText);
            }

            document.documentElement.style.setProperty('--dynamic-bg', savedBg);
            document.documentElement.style.setProperty('--dynamic-text', savedText);
        })();
    </script>

    <header class="header-banner py-3">
        <div class="container-fluid d-flex align-items-center justify-content-center text-center px-4">
            <img src="/uploads/LOGO LRR.png" alt="Logo LRR" class="me-3" style="height: 48px; width: auto; object-fit: contain;">
            <h1 class="fw-bold m-0" style="font-size: 1.35rem; letter-spacing: 0.03em;">
                LYCÉE RAHERIVELO RAMAMONJY FIANARANTSOA
            </h1>
        </div>
    </header>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container-fluid px-4">
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" id="menuPrincipal" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                📁 MENU PRINCIPAL
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="menuPrincipal">
                                <li><a class="dropdown-item" href="@Url.Action("SearchResults", "Search")">🔍 Recherche</a></li>
                                <div class="dropdown-divider"></div>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Personnels")">📜 Liste des PA et PE</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("IndexEFA", "Personnels")">👤 Liste des PA</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("IndexPE", "Personnels")">👨‍🏫 Liste des PE</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Create", "Personnels")">➕ Ajouter du Personnel</a></li>
                                <div class="dropdown-divider"></div>
                                <li><a class="dropdown-item" href="@Url.Action("STAT", "Personnels")">📊 Statistique PE</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("STAT2", "Personnels")">📈 Statistique PA</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("RETRAITE", "Personnels")">🧓 Retraités cette année</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Archive", "Search")">📁 Liste des personnels archivés</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("ExporterExcel", "Personnels")">🟢 Exporter vers Excel</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("ExporterContactsAndroid", "Personnels")">📱 Exporter Contact vers Android (.VCF)</a></li>
                                <div class="dropdown-divider"></div>
                                <li><a class="dropdown-item" href="javascript:void(0);" onclick="naviguerVersPageSecurisee('@Url.Action("AddArticle", "Article")')">🛒 Ajouter Fournitures</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);" onclick="naviguerVersPageSecurisee('@Url.Action("Index", "Article")')">📦 Liste des Articles</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);" onclick="naviguerVersPageSecurisee('@Url.Action("Add", "Decharge")')">➕ Faire une décharge</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);" onclick="naviguerVersPageSecurisee('@Url.Action("Index", "Decharge")')">📜 Liste des décharges</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center gap-3">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center position-relative px-2" href="#" id="bellModifs" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    🔔 <span id="badgeModifsCount" class="badge bg-danger badge-notify d-none">0</span>
                                </a>
                                <ul id="listModifs" class="dropdown-menu dropdown-menu-end dropdown-wide shadow p-2" aria-labelledby="bellModifs">
                                    <li class="dropdown-header text-uppercase fw-bold text-muted small border-bottom pb-1">Modifications Récentes</li>
                                    <li id="emptyModifs" class="dropdown-item text-muted text-center py-2 small">Aucune modification non lue</li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown me-2">
                                <a class="nav-link dropdown-toggle d-flex align-items-center position-relative px-2" href="#" id="bellOnline" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    🟢 <span id="badgeOnlineCount" class="badge bg-success badge-notify d-none">0</span>
                                </a>
                                <ul id="listOnlineTeachers" class="dropdown-menu dropdown-menu-end dropdown-wide shadow p-2" aria-labelledby="bellOnline">
                                    <li class="dropdown-header text-uppercase fw-bold text-muted small border-bottom pb-1">Enseignants En Ligne</li>
                                    <li id="emptyOnline" class="dropdown-item text-muted text-center py-2 small">Aucun enseignant en ligne</li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <span class="nav-link small p-0">👋 Connecté : <b>@User.Identity.Name</b></span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-danger btn-sm px-3 rounded-pill" style="font-size: 0.85rem;" href="@Url.Action("Logout", "Account")" onclick="sessionStorage.clear();">Déconnexion</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3 rounded-pill" style="font-size: 0.85rem; background-color: var(--primary-color); border: none;" href="@Url.Action("Login", "Account")">Connexion</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer>
        <div>&copy; @DateTime.Now.Year - Lycée Raherivelo Ramamonjy Fianarantsoa • Tous droits réservés.</div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="@Url.Content("~/js/site.js")"></script>

    <script>
        // --- Le reste de vos scripts (Heartbeat, Dashboard, PIN) reste inchangé et fonctionnel ---
        $(document).ready(function() {
            const isAuthenticated = "@User.Identity.IsAuthenticated" === "True";
            const isAdmin = "@User.IsInRole("Admin")" === "True";

            if (isAuthenticated) {
                envoiSignalPresence();
                setInterval(envoiSignalPresence, 60000);

                if (isAdmin) {
                    chargerDashboardTempsReel();
                    setInterval(chargerDashboardTempsReel, 60000);
                }
            }
        });

        function envoiSignalPresence() {
            $.post('/Search/Heartbeat');
        }

        function chargerDashboardTempsReel() {
            $.get('/Search/GetLiveDashboardData', function(data) {
                const notifCount = data.notifications.length;
                if (notifCount > 0) {
                    $('#badgeModifsCount').text(notifCount).removeClass('d-none');
                    $('.notification-dynamic').remove();
                    $('#emptyModifs').addClass('d-none');

                    data.notifications.forEach(function(notif) {
                        let cleanMessage = notif.message.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
                        const item = `<li class="dropdown-item notification-dynamic notification-item-text" onclick="marquerCommeLu(${notif.id}, this)">
                            ${cleanMessage} <br>
                            <span class="text-primary tracking-tight" style="font-size:0.75rem; cursor:pointer; font-weight:600;">📥 Marquer comme lu</span>
                        </li>`;
                        $('#listModifs').append(item);
                    });
                } else {
                    $('#badgeModifsCount').addClass('d-none');
                    $('.notification-dynamic').remove();
                    $('#emptyModifs').removeClass('d-none');
                }

                const teachersCount = data.teachers.length;
                if (teachersCount > 0) {
                    $('#badgeOnlineCount').text(teachersCount).removeClass('d-none');
                    $('.teacher-dynamic').remove();
                    $('#emptyOnline').addClass('d-none');

                    data.teachers.forEach(function(username) {
                        const item = `<li class="dropdown-item teacher-dynamic small py-1 text-success fw-bold" style="font-size:0.82rem;">🟢 ${username}</li>`;
                        $('#listOnlineTeachers').append(item);
                    });
                } else {
                    $('#badgeOnlineCount').addClass('d-none');
                    $('.teacher-dynamic').remove();
                    $('#emptyOnline').removeClass('d-none');
                }
            });
        }

        window.marquerCommeLu = function(id, element) {
            $.post('/Search/MarkAsRead', { id: id }, function(res) {
                if(res.success) {
                    $(element).fadeOut(250, function() { 
                        $(this).remove(); 
                        chargerDashboardTempsReel(); 
                    });
                }
            });
        };

        window.naviguerVersPageSecurisee = async function(url) {
            if (await validerAccesGeneral()) {
                window.location.href = url;
            }
        };

        window.validerAccesGeneral = async function() {
            if (estAutorise()) return true;

            const { value: pin } = await Swal.fire({
                title: '🔒 SECTION SÉCURISÉE',
                html: '<span style="color: #475569; font-size: 0.95rem;">Veuillez renseigner le code d\'autorisation requis.</span>',
                input: 'password',
                inputAttributes: {
                    autocapitalize: 'off',
                    autocorrect: 'off',
                    autocomplete: 'new-password',
                    spellcheck: 'false'
                },
                showCancelButton: true,
                confirmButtonText: 'Confirmer',
                cancelButtonText: 'Annuler',
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#94a3b8',
                background: '#ffffff',
                inputValidator: (value) => {
                    if (!value) return 'Le code d\'accès est obligatoire !';
                }
            });

            if (pin === "2026") {
                const maintenant = new Date().getTime();
                sessionStorage.setItem("osief_access_unlocked", "true");
                sessionStorage.setItem("osief_timestamp", maintenant);
                
                await Swal.fire({
                    icon: 'success',
                    title: 'Accès validé',
                    background: '#ffffff',
                    timer: 1000,
                    showConfirmButton: false
                });
                
                return true;
            } else if (pin) {
                Swal.fire({
                    icon: 'error',
                    title: 'Échec',
                    text: 'Code d\'accès incorrect.',
                    confirmButtonColor: '#ef4444',
                    background: '#ffffff'
                });
                return false;
            }
            return false;
        };

        function estAutorise() {
            const uneHeure = 60 * 60 * 1000; 
            const sessionTime = sessionStorage.getItem("osief_timestamp");
            const maintenant = new Date().getTime();
            
            if (!sessionTime || (maintenant - sessionTime > uneHeure)) {
                sessionStorage.removeItem("osief_access_unlocked");
                sessionStorage.removeItem("osief_timestamp");
                return false;
            }
            
            sessionStorage.setItem("osief_timestamp", maintenant); 
            return true;
        }
    </script>
</body>
</html>