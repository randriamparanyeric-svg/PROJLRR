<script>
    $(document).ready(function () {
        const IS_ADMIN = @(isAdmin ? "true" : "false");
        var searchUrl = "/Search/SearchPersonnel";

        // Fonctions d'affichage/masquage du Popup
        function openEditModal() {
            $("#modalOverlaymodif").fadeIn(300);
            $("#editPersonnelForm").fadeIn(300);
            $("body").css("overflow", "hidden"); // Empêche le défilement de la page arrière
        }

        function closeEditModal() {
            $("#modalOverlaymodif").fadeOut(200);
            $("#editPersonnelForm").fadeOut(200);
            $("body").css("overflow", "auto");
        }

        // Recherche par bouton (AJAX) - Uniquement si admin
        $("#btnSubmitSearch").click(function () {
            if (!IS_ADMIN) return false;
            let query = $("#PersonnelNom").val();
            if (query) {
                $.get('/Search/SearchResults', { searchTerm: query }, function (data) {
                    let content = $(data).find('#resultsContainer').html();
                    $("#resultsContainer").html(content);
                });
            }
        });

        // Autocomplete (Suggestion) - Uniquement si admin
        $("#PersonnelNom").keyup(function () {
            if (!IS_ADMIN) return false;
            let query = $(this).val().trim();
            if (query.length >= 2) {
                $.get(searchUrl, { search: query }, function (data) {
                    let s = $("#suggestions");
                    s.empty();
                    data.forEach(p => {
                        s.append(`<a href="#" class="list-group-item list-group-item-action suggestion-item" data-name="${p.nom}" style="padding: 10px 15px; border-bottom: 1px solid #f1f5f9; display: block; color: #334155; text-decoration: none;">${p.nom}</a>`);
                    });
                });
            } else {
                $("#suggestions").empty();
            }
        });

        $(document).on('click', '.suggestion-item', function(e){
            e.preventDefault();
            $("#PersonnelNom").val($(this).data('name'));
            $("#suggestions").empty();
        });

        // Fonction de sécurité pour formater les dates
        function formatHTML5Date(rawDate) {
            if (!rawDate) return '';
            let dateStr = String(rawDate).trim();

            if (dateStr.includes('/')) {
                let datePart = dateStr.split(' ')[0]; 
                let parts = datePart.split('/'); 
                if (parts.length === 3) {
                    return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
                }
            }
            if (dateStr.includes('T')) {
                return dateStr.split('T')[0];
            }
            return dateStr.substring(0, 10);
        }

        // Édition : Remplissage des données et Ouverture du Popup
$(document).on('click', '.btn-edit', function (e) {
    e.preventDefault();
    let id = $(this).data("id");
    
    $.get('/Search/GetPersonnelDetails', { id: id }, function (data) {
        // ID Caché
        $("#editNum").val(data.num);
        
        // 1. Informations Générales
        $("#editMatricule").val(data.matricule);
        $("#editNomEtPrenoms").val(data.nomEtPrenoms);
