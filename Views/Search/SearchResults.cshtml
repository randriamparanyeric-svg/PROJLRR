<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        var searchUrl = "/Search/SearchPersonnel";

        // Recherche par bouton (AJAX)
        $("#btnSubmitSearch").click(function () {
            let query = $("#PersonnelNom").val();
            if (query) {
                $.get('/Search/SearchResults', { searchTerm: query }, function (data) {
                    let content = $(data).find('#resultsContainer').html();
                    $("#resultsContainer").html(content);
                });
            }
        });

        // Autocomplete (Suggestion)
        $("#PersonnelNom").keyup(function () {
            let query = $(this).val().trim();
            if (query.length >= 2) {
                $.get(searchUrl, { search: query }, function (data) {
                    let s = $("#suggestions");
                    s.empty();
                    data.forEach(p => {
                        s.append(`<a href="#" class="list-group-item suggestion-item" data-name="${p.nom}">${p.nom} (${p.matricule})</a>`);
                    });
                });
            } else {
                $("#suggestions").empty();
            }
        });

        $(document).on('click', '.suggestion-item', function(e){
            e.preventDefault();
            $("#PersonnelNom").val($(this).data('name'));
            $("#suggestions").empty();
        });

        // Fonction de sécurité pour formater les dates reçues (FR ou ISO) au format AAAA-MM-JJ
function formatHTML5Date(rawDate) {
    if (!rawDate) return '';
    
    let dateStr = String(rawDate).trim();

    // 1. Si le serveur renvoie le format FR "14/09/2017" (avec ou sans l'heure)
    if (dateStr.includes('/')) {
        let datePart = dateStr.split(' ')[0]; 
        let parts = datePart.split('/'); // ["14", "09", "2017"]
        
        if (parts.length === 3) {
            // Reconstruit au format International requis par l'input date : "2017-09-14"
            return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
        }
    }

    // 2. Si c'est un format ISO long (ex: "2017-09-14T00:00:00")
    if (dateStr.includes('T')) {
        return dateStr.split('T')[0];
    }

    // 3. Si c'est déjà du "2017-09-14"
    return dateStr.substring(0, 10);
}

// Édition : Remplissage des données (Version Corrigée)
$(document).on('click', '.btn-edit', function () {
    let id = $(this).data("id");
    $.get('/Search/GetPersonnelDetails', { id: id }, function (data) {
        $("#editNum").val(data.num);
        $("#editMatricule").val(data.matricule);
        $("#editNomEtPrenoms").val(data.nomEtPrenoms);
        $("#editCin").val(data.cin);
        $("#editDec").val(data.dec);
        
        // .trigger('change') maintient l'affichage de vos listes de suggestions/Select2
        $("#editCorps").val(data.corps).trigger('change');
        $("#editMatiere").val(data.matiere).trigger('change');

        // --- CORRECTION ET CONVERSION DES INPUTS DATES ---
        let dateNaissRaw = data.datenaiss || data.dateNaiss || data.Datenaiss;
        let dateEntreRaw = data.datedentre || data.dateDentre || data.Datedentre;
        let datePriseRaw = data.datedeprise || data.dateDeprise || data.Datedeprise;

        $("#editDatenaiss").val(formatHTML5Date(dateNaissRaw)).trigger('change');
        $("#editDatedentre").val(formatHTML5Date(dateEntreRaw)).trigger('change');
        $("#editDatedeprise").val(formatHTML5Date(datePriseRaw)).trigger('change');
        // -------------------------------------------------

        $("#editLieudenaiss").val(data.lieudenaiss);
        $("#editSexe").val(data.sexe).trigger('change');
        $("#editStatut").val(data.statut).trigger('change');
        
        $("#editDiplomeac").val(data.diplomeac).trigger('change');
        $("#editDiplomeped").val(data.diplomeped).trigger('change');
        $("#editContact").val(data.contact);
        $("#editFonction").val(data.fonction).trigger('change');
        
        // Remplissage des Avancements
        $("#editPerav").val(data.perav);
        $("#editDemav").val(data.demav);
        $("#editTemav").val(data.temav);
        $("#editQemav").val(data.qemav);
        $("#editCemav").val(data.cemav);
        $("#editSemav").val(data.semav);
        $("#editSepmav").val(data.sepmav);
        $("#editHemav").val(data.hemav);
        $("#editNemav").val(data.nemav);
        $("#editDxemav").val(data.dxemav);
        $("#editOnemav").val(data.onemav);
        $("#editDou").val(data.dou);
        $("#editTrei").val(data.trei);
        $("#editQuat").val(data.quat);
        $("#editQuin").val(data.quin);
        $("#editSeiz").val(data.seiz);

        // Gérer l'affichage de la photo actuelle
        if (data.photo) {
            $("#editPhotoPreview").attr("src", data.photo);
        } else {
            $("#editPhotoPreview").attr("src", "/images/default.jpg"); 
        }
        
        $("#editPhotoFile").val(''); // Réinitialise l'input file caché

        $("#editPersonnelForm").slideDown();
    });
});

       $("#updateForm").submit(function(e){
    e.preventDefault();
    
    let formData = new FormData(this); // Gère les inputs texte ET le fichier photo
    
    // 1. Récupérer l'ID (Num) du personnel en cours de modification
    // (Assurez-vous d'avoir un <input type="hidden" id="editNum" name="Num" /> ou équivalent dans votre formulaire)
    let personnelNum = $("#editNum").val(); 
    
    $.ajax({ 
        url: '/Search/UpdatePersonnel', 
        type: 'POST', 
        data: formData, 
        processData: false,  // Empêche jQuery de transformer les données en string
        contentType: false,  // Empêche jQuery de forcer le header
        success: res => { 
            if (res.success) {
                alert("Enregistré avec succès !"); 
                
                // 2. On cible précisément la fiche de ce personnel
                let $card = $("#card-" + personnelNum);
                
                if ($card.length > 0) {
                    let cacheBuster = new Date().getTime(); 
                    
                    // A. Mise à jour de la photo dans le formulaire ET dans la bonne fiche
                    $("#editPhotoPreview").attr("src", res.photoUrl + "?t=" + cacheBuster);
                    $card.find(".photo-personnel").attr("src", res.photoUrl + "?t=" + cacheBuster);
                    
                    // B. Mise à jour des informations textuelles et listes déroulantes
                    $card.find(".Matricule").text($("#editMatricule").val());
                    $card.find(".nom_prenoms").text($("#editNomEtPrenoms").val()); // Ajustez l'ID selon votre formulaire
                    $card.find(".Cin").text($("#editCin").val());
                    $card.find(".Corps").text($("#editCorps").val());
                    $card.find(".Matiere").text($("#editMatiere").val());
                    $card.find(".Diplomeac").text($("#editDiplomeac").val());
                    $card.find(".Diplomeped").text($("#editDiplomeped").val());
                    $card.find(".Contact").text($("#editContact").val());
                    $card.find(".Fonction").text($("#editFonction").val());
                    
                    // C. Mise à jour des dates (Optionnel : gestion du format HTML5 YYYY-MM-DD vers FR)
                    let dateNaiss = $("#editDatenaiss").val();
                    if(dateNaiss && dateNaiss.includes("-")) {
                        let d = dateNaiss.split('-'); $card.find(".Datenaiss").text(`${d[2]}/${d[1]}/${d[0]}`);
                    }
                    let dateEntree = $("#editDatedentre").val();
                    if(dateEntree && dateEntree.includes("-")) {
                        let d = dateEntree.split('-'); $card.find(".Datedentre").text(`${d[2]}/${d[1]}/${d[0]}`);
                    }
                    let datePrise = $("#editDatedeprise").val();
                    if(datePrise && datePrise.includes("-")) {
                        let d = datePrise.split('-'); $card.find(".Datedeprise").text(`${d[2]}/${d[1]}/${d[0]}`);
                    }

                    // D. Mise à jour des Avancements (si présents dans le formulaire de modification)
                    $card.find(".Perav").text($("#editPerav").val());
                    $card.find(".Demav").text($("#editDemav").val());
                    $card.find(".Temav").text($("#editTemav").val());
                    $card.find(".Qemav").text($("#editQemav").val());
                    $card.find(".Cemav").text($("#editCemav").val());
                    $card.find(".Semav").text($("#editSemav").val());
                    $card.find(".Sepmav").text($("#editSepmav").val());
                    $card.find(".Hemav").text($("#editHemav").val());
                    $card.find(".Nemav").text($("#editNemav").val());
                    $card.find(".Dxemav").text($("#editDxemav").val());
                    $card.find(".Onemav").text($("#editOnemav").val());
                    $card.find(".Dou").text($("#editDou").val());
                    $card.find(".Trei").text($("#editTrei").val());
                    $card.find(".Quat").text($("#editQuat").val());
                    $card.find(".Quin").text($("#editQuin").val());
                    $card.find(".Seiz").text($("#editSeiz").val());
                }
                
                // On ferme le formulaire proprement
                $("#editPersonnelForm").slideUp();
            } else {
                alert("Erreur : " + res.message);
            }
        },
        error: err => {
            alert("Erreur lors de l'enregistrement.");
        }
    });
});

       $(document).on('click', '.btn-delete', function () {
    let id = $(this).data("id");
    let $card = $("#card-" + id);

    // Remplacement du confirm() natif par SweetAlert2
    Swal.fire({
        title: 'Archiver ce personnel ?',
        text: "Cette action va déplacer les données vers l'historique.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#28a745',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Oui, archiver !',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) {
            // Appel AJAX maintenu
            $.ajax({
                url: '/Search/DeletePersonnel',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        // Succès : Message SweetAlert + Suppression visuelle
                        Swal.fire('Archivé !', res.message, 'success');
                        $card.fadeOut(500, function () {
                            $(this).remove();
                        });
                    } else {
                        // Erreur gérée par le contrôleur
                        Swal.fire('Erreur', res.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Erreur', 'Une erreur de communication est survenue.', 'error');
                }
            });
        }
    });
});

