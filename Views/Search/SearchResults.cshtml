@model List<PROJLRR.Models.Personnel>
@{
    Layout = "/Views/Shared/Layout.cshtml";
    ViewData["Title"] = "Résultats de la recherche";
}

<style>
    /* CSS pour ordonner le formulaire de modification en grille */
    #editPersonnelForm {
        border: 1px solid #ccc;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    #updateForm {
        display: grid;
        grid-template-columns: 1fr 1fr; /* 2 colonnes */
        gap: 15px;
    }
    .form-group {
        display: flex;
        flex-direction: column;
    }
    .form-group label {
        font-weight: bold;
        margin-bottom: 5px;
    }
    .form-group input, .form-group select {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }
    .full-width {
        grid-column: span 2;
    }
    .photo-upload-container {
        grid-column: span 2;
        text-align: center;
        margin-bottom: 15px;
        padding: 15px;
        background: #fff;
        border: 1px dashed #999;
        border-radius: 8px;
    }
    .form-actions {
        grid-column: span 2;
        text-align: center;
        margin-top: 20px;
    }
</style>

<h5 align="center">RECHERCHE DE PERSONNEL DU LYCEE RAHERIVELO RAMAMONJY</h5>

<form id="searchForm" onsubmit="return false;">
    <div align="center" style="position: relative; display: inline-block;">
        <label for="searchTerm">Rechercher par Matricule ou Nom :</label>
        <input type="text" id="PersonnelNom" name="searchTerm" required autocomplete="off" />
        <button type="button" id="btnSubmitSearch" style="background-color: green; color: black; border: none; padding: 10px 15px; cursor: pointer;">
            🔍 Rechercher
        </button>
        <div id="suggestions" class="list-group" style="position: absolute; z-index: 1000; left: 50%; transform: translateX(-50%); width: 100%; background: white; border: 1px solid #ccc;"></div>
    </div>
</form>

<div id="resultsContainer">
    @if (Model != null && Model.Any())
    {
        @foreach (var p in Model)
        {
            <div class="personnel-card mb-4" id="card-@p.Num" style="border-bottom: 2px dashed #ccc; padding-bottom: 15px;">
                <table class="table table-striped">
                    <tbody>
                        <tr><td><img src="@Url.Content(p.Photo)" class="photo-personnel" alt="Photo de @p.NomEtPrenoms" width="150" height="200" /></td></tr>
                        <tr><th>Matricule :</th> <td class="Matricule">@p.Matricule</td></tr>
                        <tr><th>NOM ET PRÉNOMS :</th> <td class="nom_prenoms">@p.NomEtPrenoms</td></tr>
                        <tr><th>Cin :</th> <td class="Cin">@p.Cin</td></tr>
                        <tr><th>DÉCISION :</th> <td>@p.Dec</td></tr>
                        <tr><th>Corps :</th> <td class="Corps">@p.Corps</td></tr>
                        
                        <tr><th>Matiere OU BUREAU :</th> <td class="Matiere">@p.Matiere</td></tr>
                        
                        <tr><th>DATE DE NAISSANCE :</th> <td class="Datenaiss">@p.Datenaiss</td></tr>
                        <tr><th>LIEU DE NAISSANCE :</th> <td class="lieunaiss">@p.Lieudenaiss</td></tr>
                        <tr><th>Sexe :</th> <td>@p.Sexe</td></tr>
                        <tr><th>Statut :</th> <td>@p.Statut</td></tr>
                        <tr><th>DATE D'ENTRÉE :</th> <td class="Datedentre">@p.Datedentre</td></tr>
                        <tr><th>DATE PRISE :</th> <td class="Datedeprise">@p.Datedeprise</td></tr>
                        
                        <tr><th>DIPLÔME ACADÉMIQUE :</th> <td class="Diplomeac">@p.Diplomeac</td></tr>
                        
                        <tr><th>DIPLÔME PÉDAGOGIQUE :</th> <td class="Diplomeped">@p.Diplomeped</td></tr>
                        
                        <tr><th>Contact :</th> <td class="Contact">@p.Contact</td></tr>
                        <tr><th>Fonction :</th> <td class="Fonction">@p.Fonction</td></tr>
                        <tr><th>1°AVANCEMENT:</th> <td class="Perav">@p.Perav</td></tr>
                        <tr><th>2°AVANCEMENT:</th> <td class="Demav">@p.Demav</td></tr>
                        <tr><th>3°AVANCEMENT:</th> <td class="Temav">@p.Temav</td></tr>
                        <tr><th>4°AVANCEMENT:</th> <td class="Qemav">@p.Qemav</td></tr>
                        <tr><th>5°AVANCEMENT:</th> <td class="Cemav">@p.Cemav</td></tr>
                        <tr><th>6°AVANCEMENT:</th> <td class="Semav">@p.Semav</td></tr>
                        <tr><th>7°AVANCEMENT:</th> <td class="Sepmav">@p.Sepmav</td></tr>
                        <tr><th>8°AVANCEMENT:</th> <td class="Hemav">@p.Hemav</td></tr>
                        <tr><th>9°AVANCEMENT:</th> <td class="Nemav">@p.Nemav</td></tr>
                        <tr><th>10°AVANCEMENT:</th> <td class="Dxemav">@p.Dxemav</td></tr>
                        <tr><th>11°AVANCEMENT:</th> <td class="Onemav">@p.Onemav</td></tr>
                        <tr><th>12°AVANCEMENT:</th> <td class="Dou">@p.Dou</td></tr>
                        <tr><th>13°AVANCEMENT:</th> <td class="Trei">@p.Trei</td></tr>
                        <tr><th>14°AVANCEMENT:</th> <td class="Quat">@p.Quat</td></tr>
                        <tr><th>15°AVANCEMENT:</th> <td class="Quin">@p.Quin</td></tr>
                        <tr><th>16°AVANCEMENT:</th> <td class="Seiz">@p.Seiz</td></tr>
                    </tbody>
                </table>
                <div>
                    <button class="btn-edit" data-id="@p.Num" style="background-color: yellow; color: Black; border: none; padding: 10px 15px; cursor: pointer;">Modifier</button>
                   <button type="button" class="btn-delete" data-id="@p.Num" 
        style="background-color: red; color: Black; border: none; padding: 10px 15px; cursor: pointer;">
    🗑 Archiver
</button>
                    <button class="REMPLIR" style="padding: 10px 15px; cursor: pointer;">GENERER UN CERTIFICAT ADMINISTRATIF</button>
                </div>
            </div>
        }
    }
</div>
<div id="lieu" style="display: none; border: 1px solid black; padding: 20px; margin-top: 20px; width: 350px; background: #f9f9f9; border-radius: 8px;">
    <label for="inputLieu">Lieu de délivrance du Cin :</label>
