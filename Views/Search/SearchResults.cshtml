<script>
function imprimerFiche(cardId) {
    var cardElement = document.getElementById(cardId);
    if (!cardElement) return;

    // Crée une fenêtre temporaire pour l'impression
    var fenetreImpression = window.open('', '_blank', 'height=800,width=1000');
    
    fenetreImpression.document.write('<html><head><title>Fiche Personnel</title>');
    
   // Ajout des styles CSS pour garantir une mise en page identique et propre à l'impression
// ⚡ Modification : Utilisation du chemin local pour le mode hors ligne
fenetreImpression.document.write('<link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css">');
fenetreImpression.document.write('<style>');
fenetreImpression.document.write('body { font-family: "Segoe UI", Arial, sans-serif; padding: 30px; background-color: #fff; color: #000; }');
fenetreImpression.document.write('.table-custom { width: 100%; border-collapse: collapse; margin-top: 15px; }');
fenetreImpression.document.write('.table-custom th, .table-custom td { border: 1px solid #dee2e6; padding: 10px; font-size: 0.95rem; }');
fenetreImpression.document.write('.photo-personnel { display: block; margin: 0 auto 15px auto; border: 3px solid #dee2e6; border-radius: 8px; }');
fenetreImpression.document.write('.card-actions { display: none !important; }'); // Masquer définitivement les boutons sur le papier
fenetreImpression.document.write('tr { page-break-inside: avoid; }'); // Évite les coupures de lignes bizarres entre deux pages
fenetreImpression.document.write('</style></head><body>');
    
    // Injecte le HTML de la carte ciblée
    fenetreImpression.document.write(cardElement.innerHTML);
    
    fenetreImpression.document.write('</body></html>');
    fenetreImpression.document.close();

    // Attendre le chargement complet des éléments (comme la photo) avant de lancer l'impression
    fenetreImpression.onload = function() {
        fenetreImpression.focus();
        fenetreImpression.print();
        fenetreImpression.close();
    };
}
// Variable globale qui stockera la version ultra-légère de la photo
let myAppPhoto = null;

// Déclencheur du bouton masqué
$(document).on('click', '#btnTriggerUpload', function () {
    $("#editPhotoFile").click();
});

// Événement dès qu'une photo est sélectionnée
$(document).on('change', '#editPhotoFile', function () {
    let file = this.files[0];
    if (file) {
        // 🚀 ACCÉLÉRATION 1 : Aperçu local instantané (sans aucune attente réseau)
        let objectUrl = URL.createObjectURL(file);
        $('#editPhotoPreview').attr('src', objectUrl);
        $("#compressionStatus").css("color", "#eab308").text("⚡ Optimisation en cours...");

        // 🚀 ACCÉLÉRATION 2 : Compression par Canvas HTML5
        let reader = new FileReader();
        reader.onload = function (e) {
            let img = new Image();
            img.src = e.target.result;
            img.onload = function () {
                let canvas = document.createElement('canvas');
                
                // Dimensions idéales pour un trombinoscope (max 400px de large)
                let maxWidth = 400; 
                let scaleSize = maxWidth / img.width;
                
                if (img.width > maxWidth) {
                    canvas.width = maxWidth;
                    canvas.height = img.height * scaleSize;
                } else {
                    canvas.width = img.width;
                    canvas.height = img.height;
                }

                let ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                // Conversion de l'image lourde en JPEG performant (Qualité 75%)
                canvas.toBlob(function (blob) {
                    myAppPhoto = blob; // Stockage du fichier optimisé prêt pour l'envoi AJAX
                    
                    let sizeInKo = (blob.size / 1024).toFixed(1);
                    $("#compressionStatus").css("color", "#22c55e").text("✅ Photo prête et optimisée (" + sizeInKo + " Ko)");
                }, 'image/jpeg', 0.75);
            };
        };
        reader.readAsDataURL(file);
    }
});
function openCertModal(btn) {
    document.getElementById("modalOverlay").style.display = "block";
    // On récupère l'ID via le bouton cliqué
    document.getElementById("hiddenPersonId").value = btn.getAttribute("data-id");
}

function closeModal() {
    document.getElementById("modalOverlay").style.display = "none";
}

function genererCertificat() {
    // 1. Récupération des éléments
    const id = document.getElementById("hiddenPersonId").value;
    const lieu = document.getElementById("inputLieu").value.trim();
    const date = document.getElementById("inputdatecin").value;
    const chapitre = document.getElementById("inputchapitre").value;
    
    const btn = document.getElementById("btnTelecharger");
    const popup = document.getElementById("popupLoader");
    const msgErreur = document.getElementById("messageErreur");

    // 2. Validation (Ajout de chapitre === "")
    // Si l'un des trois est vide, on arrête tout.
    if (lieu === "" || date === "" || chapitre === "") {
        msgErreur.textContent = "Veuillez remplir tous les champs et sélectionner un chapitre.";
        msgErreur.style.display = "block";
        return; 
    }

    // 3. Affichage du popup
    msgErreur.style.display = "none";
    popup.style.display = "flex"; 
    btn.disabled = true;

    // 4. Transfert des données
    document.getElementById("formId").value = id;
    document.getElementById("formLieuCIN").value = lieu;
    document.getElementById("formDateCIN").value = date;
    document.getElementById("formChapitre").value = chapitre;

    // 5. Soumission
    document.getElementById("hiddenDownloadForm").submit();
    
    // 6. Fermeture après délai
    setTimeout(() => {
        closeModal();           // Ferme votre fenêtre de saisie
        popup.style.display = "none"; // Cache le popup
        btn.disabled = false;
    }, 5000);
}
</script>
