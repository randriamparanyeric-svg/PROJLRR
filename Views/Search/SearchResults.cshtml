// Prévisualisation de la photo en temps réel dès qu'on la choisit
$(document).on('change', '#editPhotoFile', function () {
    let file = this.files[0];
    if (file) {
        let reader = new FileReader();
        reader.onload = function (e) {
            // Met à jour l'image à l'écran instantanément
            $('#editPhotoPreview').attr('src', e.target.result);
        }
        reader.readAsDataURL(file);
    }
});

