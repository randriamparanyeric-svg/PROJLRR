@model List<PROJLRR.Models.Base1>

@{
    Layout = "/Views/Shared/Layout.cshtml";
    ViewData["Title"] = "Historique des Archives";
    int index = 1; // Initialisation du compteur de lignes
}

<link rel="stylesheet" href="~/css/styleArchive.css" />

<div class="container archive-container">
    <div class="archive-header">
        <h2>📋 Historique des Archives</h2>
        <p class="text-muted">Consultez et gérez la liste des personnels archivés</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-wrapper">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th class="col-num">N°</th> @* Nouvelle colonne N° *@
                        <th class="col-matricule">Matricule</th>
                        <th class="col-nom">Nom et Prénoms</th>
                        <th class="col-date">Date d'entrée</th>
                        <th class="col-cin">CIN</th>
                        <th class="col-corps">Corps</th>
                        <th class="col-contact">Contact</th>
                        <th class="col-matiere">Matière / Fonction</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="col-num row-index">@(index++)</td> @* Affichage et incrémentation automatique *@
                            <td class="col-matricule"><span class="badge-id">@p.Matricule</span></td>
                            <td class="col-nom text-emphasis">@p.NomEtPrenoms</td>
                            <td class="col-date">@p.Datedentre</td>
                            <td class="col-cin text-muted">@p.Cin</td>
                            <td class="col-corps">@p.Corps</td>
                            <td class="col-contact">@p.Contact</td>
                            <td class="col-matiere">@p.Matiere</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📂</div>
            <h3>Aucune donnée archivée</h3>
            <p>Le registre des archives ne contient aucun enregistrement pour le moment.</p>
        </div>
    }
</div>