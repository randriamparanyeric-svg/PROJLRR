@model List<PROJLRR.Models.Base1>

@{
    Layout = "/Views/Shared/Layout.cshtml";
    ViewData["Title"] = "Historique des Archives";
    int index = 1; 
}

<link rel="stylesheet" href="~/css/styleArchive.css" />

<div class="page-container">
    <div class="list-header-bar">
        <div>
            <h2 class="page-title">📋 Historique des Archives</h2>
            <p class="page-subtitle">Consultez et gérez la liste complète des personnels archivés</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div id="tableau" class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 50px;">N°</th>
                        <th>Matricule</th>
                        <th>Nom et Prénoms</th>
                        <th>Date d'entrée</th>
                        <th>CIN</th>
                        <th>Corps</th>
                        <th>Contact</th>
                        <th>Matière / Fonction</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="text-bold">@index</td>
                            <td><span class="badge-archive">@p.Matricule</span></td>
                            <td class="text-left text-dark">@p.NomEtPrenoms</td>
                            <td class="text-mono">@p.Datedentre</td>
                            <td class="text-mono" style="color: #64748b;">@p.Cin</td>
                            <td>@p.Corps</td>
                            <td class="text-mono">@p.Contact</td>
                            <td class="text-bold">@p.Matiere</td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state-card">
            <div class="empty-state-icon">📂</div>
            <h3 class="empty-state-title">Aucune donnée archivée</h3>
            <p class="empty-state-text">Le registre des archives ne contient aucun enregistrement pour le moment.</p>
        </div>
    }
</div>