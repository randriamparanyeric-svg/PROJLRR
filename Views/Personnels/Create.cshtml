@model PROJLRR.Models.Personnel
@{
    Layout = "/Views/Shared/Layout.cshtml";
    ViewData["Title"] = "Ajouter un personnel";
}

<div class="form-container">
    <div class="form-card">
        <div class="form-header">
            <h2>Ajouter un personnel</h2>
            <p>Renseignez les informations ci-dessous pour enregistrer un nouveau membre du personnel.</p>
        </div>
@{
    // Calcul automatique de l'année scolaire (Début en Septembre, Fin en Juin)
    int anneeActuelle = DateTime.Now.Year;
    int moisActuel = DateTime.Now.Month;
    
    // Si on est entre septembre (9) et décembre (12), l'année scolaire commence cette année.
    // Sinon (de janvier à août), elle a commencé l'année précédente.
    int debutAnneeScolaire = (moisActuel >= 9) ? anneeActuelle : anneeActuelle - 1;
    int finAnneeScolaire = debutAnneeScolaire + 1;
}

