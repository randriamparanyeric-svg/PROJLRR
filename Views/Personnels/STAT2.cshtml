@model List<PROJLRR.Models.Personnel>
@{
    Layout = "/Views/Shared/Layout.cshtml";
    ViewData["Title"] = "Situation du personnel administratif";
}

<link rel="stylesheet" href="~/css/stat2.css" />

<div class="page-container">
    <div class="list-header-bar">
        <div>
            <h2 class="page-title">Situation du Personnel Administratif</h2>
            <p class="page-subtitle">Répartition statistique par poste, statut et sexe au <span id="cert_date" class="text-dark" style="font-weight: 600;"></span></p>
        </div>
        <div class="action-group">
            <button class="btn-print" onclick="imprimerTableau()">
                🖨️ Imprimer la situation
            </button>
            <a href="@Url.Action("Create", "Personnels")" class="btn-primary">
                ➕ Ajouter un personnel
            </a>
        </div>
    </div>

    <div id="tableau" class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th rowspan="2" style="vertical-align: middle;">Poste / Service</th>
                    <th colspan="2">Fonctionnaire</th>
                    <th colspan="2">Contractuel</th>
                    <th colspan="2">Fram</th>
                    <th rowspan="2" style="vertical-align: middle;">Total</th>
                </tr>
                <tr>
                    <th>H</th>
                    <th>F</th>
                    <th>H</th>
                    <th>F</th>
                    <th>H</th>
                    <th>F</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var matieres = new List<string> { 
                        "PROVISEUR", "PROVISEUR ADJOINT", "ECONOME", "SG", "PROVISORAT", "SCOLARITE", 
                        "INFO", "SURVEILLANT", "COMPTABLE", "CDI", "LV II", "CAELF", "ILO", "EXAMEN", 
                        "LABO PC", "LABO SVT", "EMPL DE SERV", "INFIRMERIE", "GARDIEN" 
                    };

                    int totalH_Fonctionnaire = 0, totalF_Fonctionnaire = 0;
                    int totalH_Contractuel = 0, totalF_Contractuel = 0;
                    int totalH_FRAM = 0, totalF_FRAM = 0;
                    int totalGeneral = 0;
                }

                @foreach (var matiere in matieres)
                {
                    // Logique exacte de comptage conservée
                    var hFonctionnaire = Model.Count(p => p.Matiere?.Trim().ToUpper() == matiere.ToUpper() && p.Sexe == "H" && p.Statut?.ToUpper() == "FONCTIONNAIRE");
                    var fFonctionnaire = Model.Count(p => p.Matiere?.Trim().ToUpper() == matiere.ToUpper() && p.Sexe == "F" && p.Statut?.ToUpper() == "FONCTIONNAIRE");

                    var hContractuel = Model.Count(p => p.Matiere?.Trim().ToUpper() == matiere.ToUpper() && p.Sexe == "H" && p.Statut?.ToUpper() == "EFA");
                    var fContractuel = Model.Count(p => p.Matiere?.Trim().ToUpper() == matiere.ToUpper() && p.Sexe == "F" && p.Statut?.ToUpper() == "EFA");

                    var hFRAM = Model.Count(p => p.Matiere?.Trim().ToUpper() == matiere.ToUpper() && p.Sexe == "H" && p.Statut?.ToUpper() == "VACATAIRE");
                    var fFRAM = Model.Count(p => p.Matiere?.Trim().ToUpper() == matiere.ToUpper() && p.Sexe == "F" && p.Statut?.ToUpper() == "VACATAIRE");

                    var total = hFonctionnaire + fFonctionnaire + hContractuel + fContractuel + hFRAM + fFRAM;

                    totalH_Fonctionnaire += hFonctionnaire;
                    totalF_Fonctionnaire += fFonctionnaire;
                    totalH_Contractuel += hContractuel;
                    totalF_Contractuel += fContractuel;
                    totalH_FRAM += hFRAM;
                    totalF_FRAM += fFRAM;
                    totalGeneral += total;

                    <tr>
                        <td class="text-left text-dark" style="font-weight: 600; padding-left: 20px;">@matiere</td>
                        
                        <td>@hFonctionnaire</td>
                        <td>@fFonctionnaire</td>
                        <td>@hContractuel</td>
                        <td>@fContractuel</td>
                        <td>@hFRAM</td>
                        <td>@fFRAM</td>
                        <td class="text-bold" style="background-color: #f8fafc;">@total</td>
                    </tr>
                }

                <tr class="text-bold" style="background-color: #f1f5f9; border-top: 2px solid #cbd5e1;">
                    <td class="text-left text-dark" style="padding-left: 20px;">TOTAL</td>
                    <td>@totalH_Fonctionnaire</td>
                    <td>@totalF_Fonctionnaire</td>
                    <td>@totalH_Contractuel</td>
                    <td>@totalF_Contractuel</td>
                    <td>@totalH_FRAM</td>
                    <td>@totalF_FRAM</td>
                    <td style="color: #1e3a8a; font-size: 15px;">@totalGeneral</td>
                </tr>
            </tbody>
        </table>
    </div>

    <p style="text-align: center; margin-top: 25px; color: #64748b; font-style: italic;">
        Fait à Fianarantsoa, le <span id="cert_date1"></span>
    </p>
</div>

<script>
// Génération et affichage dynamique des dates du jour
let date = new Date();
let options = { day: "numeric", month: "long", year: "numeric" };
let today = date.toLocaleDateString("fr-FR", options);
document.getElementById("cert_date").innerText = today;
document.getElementById("cert_date1").innerText = today;

// FONCTION D'IMPRESSION SUR MESURE POUR MATRICE ADMINISTRATIVE
function imprimerTableau() {
    var contenu = document.getElementById('tableau').innerHTML;
    var pageImpression = window.open('', '_blank', 'width=950,height=750');
    
    if (!pageImpression) {
        alert("Veuillez autoriser les pop-ups pour pouvoir imprimer.");
        return;
    }

    pageImpression.document.write(`
        <html>
        <head>
            <title>Impression - Situation Personnel Administratif</title>
            <style>
                /* Suppression de la marge haute par défaut du navigateur */
                @@page {
                    margin-top: 0;
                }

                body { 
                    font-family: 'Segoe UI', Arial, sans-serif; 
                    color: #333; 
                    padding: 0 30px 30px 30px; /* 0px en haut, 30px à droite, bas et gauche */
                }
                
                h2 { color: #1e3a8a; margin-top: 20px; margin-bottom: 5px; font-size: 20px; text-transform: uppercase; text-align: center; }
                .subtitle { text-align: center; color: #475569; font-size: 14px; margin-bottom: 25px; }
                table { width: 100%; border-collapse: collapse; margin-top: 10px; }
                th, td { border: 1px solid #94a3b8; padding: 10px 6px; font-size: 13px; text-align: center; }
                th { background-color: #f1f5f9; color: #1e3a8a; font-weight: bold; text-transform: uppercase; font-size: 11px; }
                td:nth-child(1) { text-align: left; padding-left: 15px; font-weight: 500; }
                tr:nth-child(even) { background-color: #f8fafc; }
                .text-bold { font-weight: bold; }
                .signature { text-align: right; margin-top: 35px; font-style: italic; font-size: 14px; color: #334155; }
            </style>
        </head>
        <body>
            <h2>Situation du Personnel Administratif</h2>
            <div class="subtitle">En date du ${today}</div>
            
            ${contenu}
            
            <div class="signature">Fait à Fianarantsoa, le ${today}</div>
        </body>
        </html>
    `);

    pageImpression.document.close();
    pageImpression.focus();
    
    setTimeout(() => { 
        pageImpression.print(); 
        pageImpression.close(); 
    }, 400);
}
</script>