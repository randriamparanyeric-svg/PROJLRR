@model IEnumerable<PROJLRR.Models.Personnel>
@{
    Layout = "/Views/Shared/Layout.cshtml";
    ViewData["Title"] = "Personnel en âge de retraite";
    var anneeActuelle = DateTime.Now.Year;
}

<link rel="stylesheet" href="~/css/indexPE.css" />

<div class="page-container">
    <div class="list-header-bar">
        <div>
            <h2 class="page-title">Personnel en âge de retraite (@anneeActuelle)</h2>
            <p class="page-subtitle">Suivi et gestion des départs à la retraite de l'établissement ($\ge$ 60 ans)</p>
        </div>
        <div class="action-group">
            <button class="btn-print" onclick="imprimerTableau()">
                🖨️ Imprimer la liste
            </button>
            <a href="@Url.Action("Create", "Personnels")" class="btn-primary">
                ➕ Ajouter un personnel
            </a>
        </div>
    </div>

    <div id="tableau" class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Num</th>
                    <th>Matricule</th>
                    <th>Nom et Prénoms</th>
                    <th>Contact</th>
                    <th>Fonction</th>
                    <th>Date de Naissance</th>
                    <th>Âge</th>
                </tr>
            </thead>
            <tbody>
                @{
                    // Filtrage de sécurité et calcul d'âge d'origine strictement conservés
                    var retraitables = Model
                        .Where(p => !string.IsNullOrEmpty(p.Datenaiss) && p.Datenaiss.Length >= 4)
                        .Select(p => new {
                            Personnel = p,
                            AnneeNaiss = int.TryParse(p.Datenaiss.Substring(p.Datenaiss.Length - 4), out int an) ? an : 0
                        })
                        .Where(x => x.AnneeNaiss > 0 && (anneeActuelle - x.AnneeNaiss) >= 60)
                        .OrderBy(x => x.AnneeNaiss)
                        .ToList();

                    int index = 1;
                }

                @foreach (var item in retraitables)
                {
                    int age = anneeActuelle - item.AnneeNaiss;
                    <tr>
                        <td class="text-bold">@index</td>
                        <td>@item.Personnel.Matricule</td>
                        <td class="text-left text-dark">@item.Personnel.NomEtPrenoms</td>
                        <td class="text-mono">@item.Personnel.Contact</td>
                        
                        <td>@item.Personnel.Fonction</td>
                        <td class="text-mono">@item.Personnel.Datenaiss</td>
                        <td class="text-bold" style="color: #ef4444;">@age ans</td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>
</div>

<script>
// FONCTION D'IMPRESSION OPTIMISÉE (Rendu papier premium)
function imprimerTableau() {
    var contenu = document.getElementById('tableau').innerHTML;
    var pageImpression = window.open('', '_blank', 'width=900,height=700');
    
    if (!pageImpression) {
        alert("Veuillez autoriser les pop-ups pour pouvoir imprimer.");
        return;
    }
    
    pageImpression.document.write(`
        <html>
        <head>
            <title>Impression - Départs à la Retraite</title>
            <style>
                body { font-family: 'Segoe UI', Arial, sans-serif; color: #333; padding: 20px; }
                h2 { color: #1e3a8a; margin-bottom: 20px; font-size: 22px; border-bottom: 2px solid #1e3a8a; padding-bottom: 8px; text-transform: uppercase; }
                table { width: 100%; border-collapse: collapse; margin-top: 10px; }
                th, td { border: 1px solid #cbd5e1; padding: 10px 12px; font-size: 13px; text-align: center; } 
                th { background-color: #f8fafc; color: #1e3a8a; font-weight: bold; text-transform: uppercase; font-size: 11px; }
                td:nth-child(3) { text-align: left; font-weight: 500; } 
                td:nth-child(4), td:nth-child(6) { white-space: nowrap; font-family: monospace; }
                td:nth-child(7) { font-weight: bold; color: #b91c1c; }
                tr:nth-child(even) { background-color: #f8fafc; }
            </style>
        </head>
        <body>
            <h2 align="center">Liste des personnels partis à la retraite en @anneeActuelle</h2>
            ${contenu}
        </body>
        </html>
    `);

    pageImpression.document.close();
    pageImpression.focus();
    
    setTimeout(() => { 
        pageImpression.print(); 
        pageImpression.close(); 
    }, 400);
}
</script>