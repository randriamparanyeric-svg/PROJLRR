@model List<PROJLRR.Models.Personnel>

@{
    ViewData["Title"] = "Tableau de Bord Global";
    Layout = "/Views/Shared/Layout.cshtml";
}

<link rel="stylesheet" href="~/css/stat.css" />

<style>
    .dashboard-wrapper {
        background: linear-gradient(180deg, #f1f5f9 0%, #f8fafc 100%);
        min-height: 100vh;
    }

    .dash-header {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.35rem 1.6rem;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .dash-title {
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .modern-card {
        border-radius: 16px;
        border: 1px solid rgba(15, 23, 42, 0.07);
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }

    .modern-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.09);
    }

    /* Blocs de chiffres colorés */
    .bloc-personnel {
        background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
        border-left: 6px solid #4338ca !important;
    }

    .bloc-sexe {
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        border-left: 6px solid #059669 !important;
    }

    .bloc-enseignants {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border-left: 6px solid #d97706 !important;
    }

    .bloc-admin {
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        border-left: 6px solid #334155 !important;
    }

    .bloc-qualifie {
        background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
        border-left: 6px solid #7c3aed !important;
    }

    .bloc-fonctionnaire {
        background: linear-gradient(135deg, #f0fdfa 0%, #ccfbf1 100%);
        border-left: 6px solid #0d9488 !important;
    }

    .bloc-contractuel {
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        border-left: 6px solid #0284c7 !important;
    }

    .bloc-chart {
        background: #ffffff;
        border: 1px solid #e2e8f0;
    }

    .kpi-label {
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .kpi-number {
        font-size: 2.2rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.15;
    }

    .stat-pill {
        background-color: rgba(255, 255, 255, 0.85);
        color: #0f172a;
        border: 1px solid rgba(15, 23, 42, 0.06);
        border-radius: 10px;
        padding: 0.45rem 0.75rem;
        font-size: 0.86rem;
    }

    .detail-mini-table {
        background-color: rgba(255, 255, 255, 0.75);
        border-radius: 10px;
        padding: 0.45rem 0.65rem;
    }

    .synth-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 0.25rem;
        border-bottom: 1px dashed rgba(15, 23, 42, 0.14);
        font-size: 0.92rem;
        font-weight: 500;
        color: #1e293b;
    }

    .synth-item:last-of-type {
        border-bottom: none;
    }

    .synth-badge {
        font-weight: 800;
        font-size: 0.95rem;
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
        background: #ffffff;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
    }

    .synth-total-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.7rem;
        padding: 0.72rem 0.95rem;
        border-radius: 12px;
        font-weight: 800;
        color: #ffffff;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);
    }

    .section-divider-title {
        font-size: 0.82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #475569;
        margin-bottom: 0.85rem;
    }
</style>

<div class="dashboard-wrapper container-fluid py-4">
    <!-- EN-TÊTE DE LA PAGE -->
    <div class="dash-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="dash-title mb-1">📊 Tableau de Bord Global — Lycée Raherivelo Ramamonjy</h2>
            <p class="text-muted mb-0 small">Vue d'ensemble et indicateurs clés au <span id="cert_date" class="fw-semibold text-dark"></span></p>
        </div>
        <div class="action-group d-flex flex-wrap gap-2">
            <a href="@Url.Action("SearchResults", "Search")" class="btn btn-outline-primary rounded-3 px-3">🔍 Recherche</a>
            <button class="btn btn-primary rounded-3 px-3 shadow-sm" onclick="imprimerTableau()">🖨️ Imprimer </button>
        </div>
    </div>

    @{
        // --- CALCULS ET VENTILATIONS DÉTAILLÉES ---
        var matieresEnseignantes = new List<string> { "MLG", "FRA", "ANG", "ALL", "ESP", "RUS", "PHI", "HG", "MAT", "PC", "SVT", "EPS", "SES", "EAC" };
        int tH_Fonct = 0, tF_Fonct = 0, tH_Cont = 0, tF_Cont = 0, tH_Fram = 0, tF_Fram = 0, tGenEns = 0;

        foreach (var mat in matieresEnseignantes)
        {
            tH_Fonct += Model.Count(p => p.Matiere?.Trim().ToUpper() == mat.ToUpper() && (p.Sexe == "H" || p.Sexe?.ToUpper() == "HOMME") && p.Statut?.ToUpper() == "FONCTIONNAIRE");
            tF_Fonct += Model.Count(p => p.Matiere?.Trim().ToUpper() == mat.ToUpper() && (p.Sexe == "F" || p.Sexe?.ToUpper() == "FEMME") && p.Statut?.ToUpper() == "FONCTIONNAIRE");
            tH_Cont += Model.Count(p => p.Matiere?.Trim().ToUpper() == mat.ToUpper() && (p.Sexe == "H" || p.Sexe?.ToUpper() == "HOMME") && p.Statut?.ToUpper() == "EFA");
            tF_Cont += Model.Count(p => p.Matiere?.Trim().ToUpper() == mat.ToUpper() && (p.Sexe == "F" || p.Sexe?.ToUpper() == "FEMME") && p.Statut?.ToUpper() == "EFA");
            tH_Fram += Model.Count(p => p.Matiere?.Trim().ToUpper() == mat.ToUpper() && (p.Sexe == "H" || p.Sexe?.ToUpper() == "HOMME") && p.Statut?.ToUpper() == "VACATAIRE");
            tF_Fram += Model.Count(p => p.Matiere?.Trim().ToUpper() == mat.ToUpper() && (p.Sexe == "F" || p.Sexe?.ToUpper() == "FEMME") && p.Statut?.ToUpper() == "VACATAIRE");
        }
        tGenEns = tH_Fonct + tF_Fonct + tH_Cont + tF_Cont + tH_Fram + tF_Fram;

        var postesAdmin = new List<string> { "PROVISEUR", "PROVISEUR ADJOINT", "ECONOME", "SG", "PROVISORAT", "SCOLARITE", "INFO", "SURVEILLANT", "COMPTABLE", "CDI", "LV II", "CAELF", "ILO", "EXAMEN", "LABO PC", "LABO SVT", "EMPL DE SERV", "INFIRMERIE", "GARDIEN" };
        int aH_Fonct = 0, aF_Fonct = 0, aH_Cont = 0, aF_Cont = 0, aH_Fram = 0, aF_Fram = 0, aGenAdmin = 0;

        foreach (var poste in postesAdmin)
        {
            aH_Fonct += Model.Count(p => p.Matiere?.Trim().ToUpper() == poste.ToUpper() && (p.Sexe == "H" || p.Sexe?.ToUpper() == "HOMME") && p.Statut?.ToUpper() == "FONCTIONNAIRE");
            aF_Fonct += Model.Count(p => p.Matiere?.Trim().ToUpper() == poste.ToUpper() && (p.Sexe == "F" || p.Sexe?.ToUpper() == "FEMME") && p.Statut?.ToUpper() == "FONCTIONNAIRE");
            aH_Cont += Model.Count(p => p.Matiere?.Trim().ToUpper() == poste.ToUpper() && (p.Sexe == "H" || p.Sexe?.ToUpper() == "HOMME") && p.Statut?.ToUpper() == "EFA");
            aF_Cont += Model.Count(p => p.Matiere?.Trim().ToUpper() == poste.ToUpper() && (p.Sexe == "F" || p.Sexe?.ToUpper() == "FEMME") && p.Statut?.ToUpper() == "EFA");
            aH_Fram += Model.Count(p => p.Matiere?.Trim().ToUpper() == poste.ToUpper() && (p.Sexe == "H" || p.Sexe?.ToUpper() == "HOMME") && p.Statut?.ToUpper() == "VACATAIRE");
            aF_Fram += Model.Count(p => p.Matiere?.Trim().ToUpper() == poste.ToUpper() && (p.Sexe == "F" || p.Sexe?.ToUpper() == "FEMME") && p.Statut?.ToUpper() == "VACATAIRE");
        }
        aGenAdmin = aH_Fonct + aF_Fonct + aH_Cont + aF_Cont + aH_Fram + aF_Fram;

        // --- GROUPES DE MATIÈRES ---
        var matieresLitteraires = new List<string> { "MLG", "FRA", "ANG", "ALL", "ESP", "RUS", "PHI", "HG" };
        var matieresScientifiques = new List<string> { "SVT", "MAT", "PC" };

        // --- FONCTIONS LOCALES DE COMPTAGE ---
        Func<PROJLRR.Models.Personnel, bool> estQualifie = p =>
        {
            var diplome = (p.Diplomeped ?? "").ToUpper();
            return diplome.Contains("CAPEN") || diplome.Contains("MAPEN");
        };

        // 1er Bloc : Enseignants qualifiés (CAPEN / MAPEN)
        int qualifieLitt = Model.Count(p => p.Matiere != null && matieresLitteraires.Contains(p.Matiere.Trim().ToUpper()) && estQualifie(p));
        int qualifieSci = Model.Count(p => p.Matiere != null && matieresScientifiques.Contains(p.Matiere.Trim().ToUpper()) && estQualifie(p));
        int totalQualifie = qualifieLitt + qualifieSci;

        // 2ème Bloc : Enseignants fonctionnaires (Tous diplômes)
        int fonctLitt = Model.Count(p => p.Matiere != null && matieresLitteraires.Contains(p.Matiere.Trim().ToUpper()) && (p.Statut?.Trim().ToUpper() ?? "") == "FONCTIONNAIRE");
        int fonctSci = Model.Count(p => p.Matiere != null && matieresScientifiques.Contains(p.Matiere.Trim().ToUpper()) && (p.Statut?.Trim().ToUpper() ?? "") == "FONCTIONNAIRE");
        int totalFonct = fonctLitt + fonctSci;

        // 3ème Bloc : Enseignants contractuels / EFA (Tous diplômes)
        int contLitt = Model.Count(p => p.Matiere != null && matieresLitteraires.Contains(p.Matiere.Trim().ToUpper()) && (p.Statut?.Trim().ToUpper() ?? "") == "EFA");
        int contSci = Model.Count(p => p.Matiere != null && matieresScientifiques.Contains(p.Matiere.Trim().ToUpper()) && (p.Statut?.Trim().ToUpper() ?? "") == "EFA");
        int totalCont = contLitt + contSci;

        int totalHommes = Model.Count(p => p.Sexe != null && (p.Sexe.ToUpper() == "H" || p.Sexe.ToUpper().StartsWith("M")));
        int totalFemmes = Model.Count(p => p.Sexe != null && (p.Sexe.ToUpper() == "F" || p.Sexe.ToUpper().StartsWith("F")));
    }

    <!-- ================================================================= -->
    <!-- 1. BLOCS DE CHIFFRES CLÉS (KPIs) GLOBAUX & DÉTAILLÉS              -->
    <!-- ================================================================= -->
    <div class="section-divider-title">Indicateurs Globaux & Répartition par Catégorie</div>
    <div class="row g-3 mb-4">
        <!-- Carte 1 : Effectif Global -->
        <div class="col-md-3">
            <div class="modern-card bloc-personnel h-100 p-3 d-flex flex-column justify-content-between">
                <div class="kpi-label" style="color: #4338ca;">Nombre total des Personnels</div>
                <div class="kpi-number my-2">@Model.Count</div>
                <div class="small fw-medium" style="color: #3730a3;">Agents enregistrés dans la base</div>
            </div>
        </div>

        <!-- Carte 2 : Total Sexe Global -->
        <div class="col-md-3">
            <div class="modern-card bloc-sexe h-100 p-3 d-flex flex-column justify-content-between">
                <div class="kpi-label mb-2" style="color: #059669;">Nombre Par Sexe</div>
                <div class="d-flex flex-column gap-2">
                    <div class="stat-pill d-flex justify-content-between align-items-center">
                        <span>Hommes</span>
                        <span class="fw-bold fs-6" style="color: #047857;">@totalHommes</span>
                    </div>
                    <div class="stat-pill d-flex justify-content-between align-items-center">
                        <span>Femmes</span>
                        <span class="fw-bold fs-6" style="color: #047857;">@totalFemmes</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Carte 3 : Résumé Détaillé Total Enseignants -->
        <div class="col-md-3">
            <div class="modern-card bloc-enseignants h-100 p-3 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="kpi-label" style="color: #b45309;">📚 Nombre total des Personnels Enseignants</span>
                    <span class="badge rounded-pill text-bg-warning fs-6 px-3 shadow-xs">@tGenEns</span>
                </div>
                <div class="detail-mini-table">
                    <table class="w-100 small text-secondary" style="line-height: 1.65;">
                        <tr>
                            <td class="fw-semibold text-dark">Fonctionnaires</td>
                            <td class="text-end">H : <b class="text-dark">@tH_Fonct</b></td>
                            <td class="text-end">F : <b class="text-dark">@tF_Fonct</b></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-dark">EFA (Cont.)</td>
                            <td class="text-end">H : <b class="text-dark">@tH_Cont</b></td>
                            <td class="text-end">F : <b class="text-dark">@tF_Cont</b></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-dark">Fram (Vac.)</td>
                            <td class="text-end">H : <b class="text-dark">@tH_Fram</b></td>
                            <td class="text-end">F : <b class="text-dark">@tF_Fram</b></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Carte 4 : Résumé Détaillé Total Administratif -->
        <div class="col-md-3">
            <div class="modern-card bloc-admin h-100 p-3 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="kpi-label" style="color: #334155;">🏢 Nombre total des Personnels Administratif</span>
                    <span class="badge rounded-pill text-bg-secondary fs-6 px-3 shadow-xs">@aGenAdmin</span>
                </div>
                <div class="detail-mini-table">
                    <table class="w-100 small text-secondary" style="line-height: 1.65;">
                        <tr>
                            <td class="fw-semibold text-dark">Fonctionnaires</td>
                            <td class="text-end">H : <b class="text-dark">@aH_Fonct</b></td>
                            <td class="text-end">F : <b class="text-dark">@aF_Fonct</b></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-dark">EFA (Cont.)</td>
                            <td class="text-end">H : <b class="text-dark">@aH_Cont</b></td>
                            <td class="text-end">F : <b class="text-dark">@aF_Cont</b></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-dark">Fram (Vac.)</td>
                            <td class="text-end">H : <b class="text-dark">@aH_Fram</b></td>
                            <td class="text-end">F : <b class="text-dark">@aF_Fram</b></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- 1B. BLOCS CHIFFRES SYNTHÈSE (QUALIFIÉS / FONCTIONNAIRES / EFA)   -->
    <!-- ================================================================= -->
    <div class="section-divider-title">Synthèse Enseignants Littéraires & Scientifiques</div>
    <div class="row g-3 mb-4">
        <!-- 1er Bloc -->
        <div class="col-md-4">
            <div class="modern-card bloc-qualifie h-100 p-3 d-flex flex-column justify-content-between">
                <div>
                    <div class="kpi-label mb-2" style="color: #6d28d9;">🎓 Qualification Pédagogique</div>
                    <div class="synth-item">
                        <span> Nombre des Enseignants qualifié literaire</span>
                        <span class="synth-badge" style="color: #5b21b6;">@qualifieLitt</span>
                    </div>
                    <div class="synth-item">
                        <span>Nombre des Enseignant qualifié scientifique</span>
                        <span class="synth-badge" style="color: #5b21b6;">@qualifieSci</span>
                    </div>
                </div>
                <div class="synth-total-box" style="background: linear-gradient(90deg, #6d28d9 0%, #5b21b6 100%);">
                    <span>TOTAL</span>
                    <span class="fs-5">@totalQualifie</span>
                </div>
            </div>
        </div>

        <!-- 2ème Bloc -->
        <div class="col-md-4">
            <div class="modern-card bloc-fonctionnaire h-100 p-3 d-flex flex-column justify-content-between">
                <div>
                    <div class="kpi-label mb-2" style="color: #0f766e;">🏛️ Nombre des Fonctionnaires</div>
                    <div class="synth-item">
                        <span>Enseignant Fonctionnaire Littéraire</span>
                        <span class="synth-badge" style="color: #115e59;">@fonctLitt</span>
                    </div>
                    <div class="synth-item">
                        <span>Enseignant Fonctionaire Scientifique</span>
                        <span class="synth-badge" style="color: #115e59;">@fonctSci</span>
                    </div>
                </div>
                <div class="synth-total-box" style="background: linear-gradient(90deg, #0d9488 0%, #0f766e 100%);">
                    <span>TOTAL</span>
                    <span class="fs-5">@totalFonct</span>
                </div>
            </div>
        </div>

        <!-- 3ème Bloc -->
        <div class="col-md-4">
            <div class="modern-card bloc-contractuel h-100 p-3 d-flex flex-column justify-content-between">
                <div>
                    <div class="kpi-label mb-2" style="color: #0369a1;">📝 Nombre des Contractuels (EFA)</div>
                    <div class="synth-item">
                        <span>Enseignant Contractuel Littéraire</span>
                        <span class="synth-badge" style="color: #075985;">@contLitt</span>
                    </div>
                    <div class="synth-item">
                        <span>Enseignant Contractuel scientifique</span>
                        <span class="synth-badge" style="color: #075985;">@contSci</span>
                    </div>
                </div>
                <div class="synth-total-box" style="background: linear-gradient(90deg, #0284c7 0%, #0369a1 100%);">
                    <span>TOTAL</span>
                    <span class="fs-5">@totalCont</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- 2. GRAPHIQUES ANALYTIQUES (Chart.js)                              -->
    <!-- ================================================================= -->
    <div class="section-divider-title">Visualisation Analytique</div>
    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="modern-card bloc-chart h-100">
                <div class="bg-white fw-bold px-4 py-3 border-bottom text-dark">Répartition par Statut Global</div>
                <div class="p-3 d-flex justify-content-center align-items-center" style="height: 290px;">
                    <canvas id="statutChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="modern-card bloc-chart h-100">
                <div class="bg-white fw-bold px-4 py-3 border-bottom text-dark">Top 6 des Matières / Postes</div>
                <div class="p-3 d-flex justify-content-center align-items-center" style="height: 290px;">
                    <canvas id="matiereChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- SIGNATURE ADMINISTRATIVE -->
    <div style="text-align: right; margin-top: 35px; margin-bottom: 20px; font-style: italic; font-size: 14px; color: #334155;">
        Fait à Fianarantsoa, le <span id="cert_date1"></span>
    </div>
</div>

@section Scripts {
    <script src="~/js/chart.min.js"></script>
    <script>
        // Génération et affichage dynamique des dates du jour en français
        let date = new Date();
        let options = { day: "numeric", month: "long", year: "numeric" };
        let today = date.toLocaleDateString("fr-FR", options);
        document.getElementById("cert_date").innerText = today;
        document.getElementById("cert_date1").innerText = today;

        // Récupération sécurisée des données de la liste transmise par le modèle C#
        const personnels = @Json.Serialize(Model);

        // Variables globales pour stocker les instances Chart.js (utiles pour l'impression)
        let statutChartInstance = null;
        let matiereChartInstance = null;

        // 1. Calcul dynamique pour le graphique Camembert (Statut)
        const statutsCount = {};
        personnels.forEach(p => {
            let s = p.statut ? p.statut.toUpperCase() : "NON DÉFINI";
            statutsCount[s] = (statutsCount[s] || 0) + 1;
        });

        if (Object.keys(statutsCount).length > 0) {
            const ctxStatut = document.getElementById('statutChart').getContext('2d');
            statutChartInstance = new Chart(ctxStatut, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(statutsCount),
                    datasets: [{
                        data: Object.values(statutsCount),
                        backgroundColor: ['#4f46e5', '#10b981', '#0ea5e9', '#f59e0b', '#ef4444']
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }

        // 2. Calcul dynamique pour le graphique en Barres (Top Matières / Postes)
        const matieresCount = {};
        personnels.forEach(p => {
            if (p.matiere) {
                let m = p.matiere.trim().toUpperCase();
                matieresCount[m] = (matieresCount[m] || 0) + 1;
            }
        });
        
        // Tri décroissant et sélection des 6 principales valeurs
        const sortedMatieres = Object.entries(matieresCount).sort((a, b) => b[1] - a[1]).slice(0, 6);

        if (sortedMatieres.length > 0) {
            const ctxMatiere = document.getElementById('matiereChart').getContext('2d');
            matiereChartInstance = new Chart(ctxMatiere, {
                type: 'bar',
                data: {
                    labels: sortedMatieres.map(item => item[0]),
                    datasets: [{
                        label: 'Effectif',
                        data: sortedMatieres.map(item => item[1]),
                        backgroundColor: '#4f46e5',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });
        }

        // FONCTION D'IMPRESSION SUR MESURE POUR LE TABLEAU DE BORD
        function imprimerTableau() {
            // Conversion des graphiques Chart.js en images base64 pour impression pop-up
            let statutImg = statutChartInstance ? statutChartInstance.toBase64Image() : '';
            let matiereImg = matiereChartInstance ? matiereChartInstance.toBase64Image() : '';

            var pageImpression = window.open('', '_blank', 'width=1024,height=780');
            
            if (!pageImpression) {
                alert("Veuillez autoriser les pop-ups pour pouvoir imprimer.");
                return;
            }

            pageImpression.document.write(`
                <html>
                <head>
                    <title>Impression - Tableau de Bord Global</title>
                    <style>
                        @@page {
                            size: A4 portrait;
                            margin: 12mm 14mm;
                        }

                        * {
                            box-sizing: border-box;
                            -webkit-print-color-adjust: exact !important;
                            print-color-adjust: exact !important;
                        }

                        body { 
                            font-family: 'Segoe UI', Arial, sans-serif; 
                            color: #1e293b; 
                            margin: 0;
                            padding: 0; 
                            background: #ffffff;
                        }

                        .print-banner {
                            text-align: center;
                            padding-bottom: 12px;
                            margin-bottom: 18px;
                            border-bottom: 2px solid #cbd5e1;
                        }
                        
                        h2 { color: #0f172a; margin: 0 0 4px 0; font-size: 19px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.4px; }
                        .subtitle { color: #64748b; font-size: 13px; font-weight: 500; }

                        .print-section-label {
                            font-size: 11px;
                            font-weight: 800;
                            text-transform: uppercase;
                            letter-spacing: 0.7px;
                            color: #475569;
                            margin: 12px 0 8px 0;
                        }
                        
                        .row { display: flex; flex-wrap: wrap; margin-bottom: 12px; gap: 12px; justify-content: space-between; }
                        .col-md-3 { width: calc(25% - 9px); min-width: 150px; }
                        .col-md-4 { width: calc(33.33% - 8px); min-width: 190px; }
                        .col-lg-5 { width: calc(42% - 6px); min-width: 240px; text-align: center; }
                        .col-lg-7 { width: calc(58% - 6px); min-width: 280px; text-align: center; }
                        
                        .card { border: 1px solid #cbd5e1; border-radius: 10px; padding: 12px; background: #fff; height: 100%; display: flex; flex-direction: column; justify-content: space-between; }
                        .card-title { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
                        .display-6 { font-size: 24px; font-weight: 800; margin: 4px 0; color: #0f172a; }
                        .small { font-size: 11.5px; line-height: 1.4; color: #334155; }
                        hr { border: 0; border-top: 1px solid rgba(15, 23, 42, 0.12); margin: 6px 0; }

                        .p-bloc-personnel { background-color: #eef2ff; border-left: 5px solid #4338ca; }
                        .p-bloc-sexe { background-color: #ecfdf5; border-left: 5px solid #059669; }
                        .p-bloc-ens { background-color: #fffbeb; border-left: 5px solid #d97706; }
                        .p-bloc-admin { background-color: #f1f5f9; border-left: 5px solid #334155; }

                        .p-bloc-qual { background-color: #f5f3ff; border-left: 5px solid #7c3aed; }
                        .p-bloc-fonct { background-color: #f0fdfa; border-left: 5px solid #0d9488; }
                        .p-bloc-cont { background-color: #f0f9ff; border-left: 5px solid #0284c7; }
                        
                        .synth-row { display: flex; justify-content: space-between; align-items: center; padding: 5px 2px; border-bottom: 1px dashed rgba(15, 23, 42, 0.15); font-size: 12px; }
                        .synth-row:last-of-type { border-bottom: none; }
                        .synth-total { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; margin-top: 8px; border-radius: 7px; font-size: 13px; font-weight: 800; color: #ffffff; }
                        
                        img.chart-print { max-width: 100%; max-height: 190px; object-fit: contain; margin: 6px auto 0 auto; }
                        .signature { text-align: right; margin-top: 24px; font-style: italic; font-size: 13.5px; font-weight: 600; color: #334155; }
                        
                        table.print-table { width: 100%; font-size: 11.5px; border-collapse: collapse; background: rgba(255,255,255,0.75); border-radius: 6px; }
                        table.print-table td { padding: 2px 4px; }
                    </style>
                </head>
                <body>
                    <div class="print-banner">
                        <h2>Tableau de Bord Global — Lycée Raherivelo Ramamonjy</h2>
                        <div class="subtitle">Situation en date du ${today}</div>
                    </div>

                    <div class="print-section-label">Indicateurs Globaux & Répartition par Catégorie</div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="card p-bloc-personnel">
                                <div class="card-title" style="color: #4338ca;">Total Personnel</div>
                                <div class="display-6">@Model.Count</div>
                                <div class="small" style="color: #3730a3;">Agents enregistrés</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-bloc-sexe">
                                <div class="card-title" style="color: #059669;">Par Sexe</div>
                                <div class="small">Hommes : <b>@totalHommes</b></div>
                                <div class="small">Femmes : <b>@totalFemmes</b></div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-bloc-ens">
                                <div class="card-title" style="color: #b45309;">📚 Total Enseignants : <b>@tGenEns</b></div>
                                <hr>
                                <table class="print-table">
                                    <tr><td>Fonct</td><td style="text-align:right;">H : <b>@tH_Fonct</b></td><td style="text-align:right;">F : <b>@tF_Fonct</b></td></tr>
                                    <tr><td>EFA</td><td style="text-align:right;">H : <b>@tH_Cont</b></td><td style="text-align:right;">F : <b>@tF_Cont</b></td></tr>
                                    <tr><td>Fram</td><td style="text-align:right;">H : <b>@tH_Fram</b></td><td style="text-align:right;">F : <b>@tF_Fram</b></td></tr>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-bloc-admin">
                                <div class="card-title" style="color: #334155;">🏢 Total Admin : <b>@aGenAdmin</b></div>
                                <hr>
                                <table class="print-table">
                                    <tr><td>Fonct</td><td style="text-align:right;">H : <b>@aH_Fonct</b></td><td style="text-align:right;">F : <b>@aF_Fonct</b></td></tr>
                                    <tr><td>EFA</td><td style="text-align:right;">H : <b>@aH_Cont</b></td><td style="text-align:right;">F : <b>@aF_Cont</b></td></tr>
                                    <tr><td>Fram</td><td style="text-align:right;">H : <b>@aH_Fram</b></td><td style="text-align:right;">F : <b>@aF_Fram</b></td></tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="print-section-label">Synthèse Enseignants Littéraires & Scientifiques</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card p-bloc-qual">
                                <div>
                                    <div class="card-title" style="color: #6d28d9;">🎓 Qualification Pédagogique</div>
                                    <div class="synth-row"><span>Enseignant qualifié literaire</span><b>@qualifieLitt</b></div>
                                    <div class="synth-row"><span>Enseignant qualifié scientifique</span><b>@qualifieSci</b></div>
                                </div>
                                <div class="synth-total" style="background-color: #6d28d9;"><span>TOTAL</span><span>@totalQualifie</span></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card p-bloc-fonct">
                                <div>
                                    <div class="card-title" style="color: #0f766e;">🏛️ Corps des Fonctionnaires</div>
                                    <div class="synth-row"><span>Enseignant fonctionnaire Literaire</span><b>@fonctLitt</b></div>
                                    <div class="synth-row"><span>Enseignant Fonctionaire Scientifique</span><b>@fonctSci</b></div>
                                </div>
                                <div class="synth-total" style="background-color: #0d9488;"><span>TOTAL</span><span>@totalFonct</span></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card p-bloc-cont">
                                <div>
                                    <div class="card-title" style="color: #0369a1;">📝 Corps Contractuels (EFA)</div>
                                    <div class="synth-row"><span>Enseignant contractuel Literaire</span><b>@contLitt</b></div>
                                    <div class="synth-row"><span>Enseignant Contractuel scientifique</span><b>@contSci</b></div>
                                </div>
                                <div class="synth-total" style="background-color: #0284c7;"><span>TOTAL</span><span>@totalCont</span></div>
                            </div>
                        </div>
                    </div>

                    <div class="print-section-label">Visualisation Analytique</div>
                    <div class="row">
                        <div class="col-lg-5">
                            <div class="card">
                                <div class="card-title" style="color: #0f172a;">Répartition par Statut Global</div>
                                ${statutImg ? `<img src="${statutImg}" class="chart-print" />` : ''}
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="card">
                                <div class="card-title" style="color: #0f172a;">Top 6 des Matières / Postes</div>
                                ${matiereImg ? `<img src="${matiereImg}" class="chart-print" />` : ''}
                            </div>
                        </div>
                    </div>
                    
                    <div class="signature">Fait à Fianarantsoa, le ${today}</div>
                </body>
                </html>
            `);

            pageImpression.document.close();
            pageImpression.focus();
            
            setTimeout(() => { 
                pageImpression.print(); 
                pageImpression.close(); 
            }, 500);
        }
    </script>
}