@model List<PROJLRR.Models.DechargeFusionnee>
@{
    Layout = "/Views/Shared/Layout.cshtml";
    ViewData["Title"] = "DÉCHARGES PAR PERSONNEL";
}

<h2 align="center">@ViewData["Title"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<link rel="stylesheet" href="~/css/style8.css" />

<!-- Zone de texte pour rechercher un personnel -->
<div class="form-group">
    <label for="PersonnelNom">Nom du Personnel</label>
    <input type="text" class="form-control" id="PersonnelNom" name="PersonnelNom"
           required autocomplete="off" value="@ViewBag.LastPersonnelNom" />
    <div id="suggestions" class="list-group" style="position: absolute; z-index: 1000;"></div>
</div>

<a href="@Url.Action("Add", "Decharge")" class="btn btn-primary">Nouvelle Décharge</a>

<div id="tableau" class="table-wrapper">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>NOM DU PERSONNEL</th>
                <th>MATIERE <br> OU <br>  BUREAU</th>
                <th>MATRICULE</th>
                <th>ARTICLES DÉCHARGÉS</th>
                <th>DATE DE DECHARGE</th>
                <th>SIGNATURE</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var decharge in Model)
            {
                <tr class="dechargeRow" data-personnel="@decharge.PersonnelNom.ToLower().Trim()">
                    <td>@decharge.PersonnelNom</td>
                    <td>@decharge.MATIERE</td>
                    <td>@decharge.MATRICULE</td>
                    <td>@Html.Raw(decharge.ArticlesFusionnes)</td>
                    <td>@decharge.DateDecharge.ToString("dd/MM/yyyy")</td>
                     <td> <!-- Colonne signature -->
                @if (!string.IsNullOrEmpty(decharge.SignaturePath))
                {
                    <img src="@decharge.SignaturePath" alt="Signature" style="height: 60px;" />
                }
                else
                {
                    <span>Non signée</span>
                }
            </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Bouton d'impression -->
<button onclick="imprimerTableau()" class="no-print">🖨️ Imprimer</button>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
   function imprimerTableau() {
         const contenu = document.getElementById('tableau').innerHTML;

    const pageImpression = window.open('', '_blank', 'width=800,height=600');
    if (!pageImpression) {
        alert("Veuillez autoriser les pop-ups pour imprimer.");
        return;
    }

    const html = `
        <!DOCTYPE html>
        <html lang="fr">
        <head>
            <meta charset="UTF-8">
            <title>Impression</title>
            <style>
                body {
                    font-family: Arial, sans-serif;
                    margin: 20px;
                    margin-left: 0px;
                    color: #000;
                }
                h2 {
                    text-align: center;
                    margin-bottom: 20px;
                }
                table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-top: 10px;
                }
                th, td {
                    border: 1px solid #000;
                    padding: 8px;
                    text-align: center;
                }
                th {
                    background-color: #f2f2f2;
                }
                td:first-child {
                    text-align: left;
                }
                /* Élargir la 3ᵉ colonne */
                td:nth-child(4), th:nth-child(3) {
                    width: 200px; /* Ajustez cette valeur si nécessaire */
                    white-space: nowrap; /* Empêche les coupures de mots */
                    text-align:left;
                }

            </style>
        </head>
        <body>
            <h2>LISTE DE VOTRE DECHARGE</h2>
            <div class="table-wrapper">
                ${contenu}
            </div>
        </body>
        </html>
    `;

    pageImpression.document.open();
    pageImpression.document.write(html);
    pageImpression.document.close();

    pageImpression.onload = function () {
        pageImpression.focus();
        pageImpression.print();
        pageImpression.close();
    };
    }

    function filtrerListe(nom) {
        let searchValue = nom.toLowerCase().trim();

        $(".dechargeRow").each(function () {
            let personnelName = $(this).data("personnel");

            if (personnelName.includes(searchValue) || searchValue === "") {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    }

    $(document).ready(function () {
        $("#PersonnelNom").focus(); // focus auto

        // Appliquer le filtre si le champ contient déjà une valeur (ex. après un retour)
        const initialNom = $("#PersonnelNom").val().trim();
        if (initialNom !== "") filtrerListe(initialNom);

        $("#PersonnelNom").keyup(function () {
            let query = $(this).val().trim();

            if (query.length >= 2) {
                $.ajax({
                    url: "/Decharge/SearchPersonnel",
                    type: "GET",
                    data: { search: query },
                    success: function (data) {
                        let suggestions = $("#suggestions");
                        suggestions.empty();
                        let matchExact = false;

                        if (data.length > 0) {
                            data.forEach(function (personnel) {
                                let affichage = $.isNumeric(query) ? personnel.matricule : personnel.nom;

                                if (affichage.toLowerCase().trim() === query.toLowerCase()) {
                                    matchExact = true;
                                }

                                suggestions.append(
                                    '<a href="#" class="list-group-item list-group-item-action suggestion-item" ' +
                                    'data-name="' + personnel.nom + '">' + affichage + '</a>'
                                );
                            });
                        } else {
                            suggestions.append('<div class="list-group-item">Aucun résultat</div>');
                        }

                        if (matchExact) {
                            suggestions.empty(); // ne pas afficher si match exact
                            filtrerListe(query); // filtrage automatique
                        }
                    }
                });
            } else {
                $("#suggestions").empty();
                filtrerListe(query);
            }
        });

        $(document).on("click", ".suggestion-item", function () {
            let selectedName = $(this).data("name");
            $("#PersonnelNom").val(selectedName);
            $("#suggestions").empty();
            filtrerListe(selectedName);
        });

        $(document).click(function (e) {
            if (!$(e.target).closest("#PersonnelNom, #suggestions").length) {
                $("#suggestions").empty();
            }
        });
    });
</script>