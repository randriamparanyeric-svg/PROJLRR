@model List<PROJLRR.Models.DechargeFusionnee>
@{
    Layout = "/Views/Shared/Layout.cshtml";
    ViewData["Title"] = "DÉCHARGES PAR PERSONNEL";
}

<link rel="stylesheet" href="~/css/style8.css" />

<div class="dashboard-container">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-modern success-alert">
            <span class="alert-icon">✓</span> @TempData["SuccessMessage"]
        </div>
    }

    <div class="dashboard-header">
        <div class="header-text">
            <h2 class="page-main-title">@ViewData["Title"]</h2>
            <p class="page-subtitle">Recherchez, consultez et imprimez les fiches d'affectation du personnel</p>
        </div>
    </div>

    <div class="control-panel no-print">
        <div class="search-box-container">
            <label for="PersonnelNom" class="search-label">Filtrer par Nom / Matricule</label>
            <div class="input-relative-wrapper">
                <input type="text" class="search-input" id="PersonnelNom" name="PersonnelNom"
                       placeholder="Commencez à saisir un nom..." required autocomplete="off" value="@ViewBag.LastPersonnelNom" />
                <div id="suggestions" class="suggestions-dropdown-card"></div>
            </div>
        </div>
        
        <div class="action-buttons-group">
            <a href="@Url.Action("Add", "Decharge")" class="btn-modern btn-primary">
                <span>➕</span> Nouvelle Décharge
            </a>
            <button onclick="imprimerTableau()" class="btn-modern btn-dark">
                <span>🖨️</span> Imprimer Registre
            </button>
        </div>
    </div>

    <div id="tableau" class="modern-table-card">
        <table class="dashboard-data-table">
            <thead>
                <tr>
                    <th class="col-perso">NOM DU PERSONNEL</th>
                    <th class="col-bureau">MATIÈRE OU BUREAU</th>
                    <th class="col-matr">MATRICULE</th>
                    <th class="col-articles">ARTICLES DÉCHARGÉS</th>
                    <th class="col-date">DATE DE DÉCHARGE</th>
                    <th class="col-sign">SIGNATURE</th>
                    <th class="col-actions no-print" style="width: 60px; text-align: center;">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var decharge in Model)
                {
                    <tr class="dechargeRow" data-personnel="@decharge.PersonnelNom.ToLower().Trim()">
                        <td class="col-perso text-left font-weight-bold text-dark">@decharge.PersonnelNom</td>
                        <td class="col-bureau">@decharge.MATIERE</td>
                        <td class="col-matr font-mono text-muted">@decharge.MATRICULE</td>
                        <td class="col-articles text-left line-height-spaced">@Html.Raw(decharge.ArticlesFusionnes)</td>
                        <td class="col-date font-mono">@decharge.DateDecharge.ToString("dd/MM/yyyy")</td>
                        <td class="col-sign">
                            @if (!string.IsNullOrEmpty(decharge.SignaturePath))
                            {
                                <img src="@decharge.SignaturePath" alt="Signature" class="table-signature-img" />
                            }
                            else
                            {
                                <span class="badge-unsigned">Non signée</span>
                            }
                        </td>
                        <td class="col-actions no-print" style="text-align: center;">
                            <a href="@Url.Action("Edit", "Decharge", new { id = decharge.Id })" 
                               class="btn-modern btn-warning" 
                               style="padding: 4px 8px; font-size: 13px; text-decoration: none;" 
                               title="Modifier cette décharge">
                                <span>✏️</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/js/jquery-3.6.0.min.js"></script>

<script>
   function imprimerTableau() {
    const contenu = document.getElementById('tableau').innerHTML;
    const pageImpression = window.open('', '_blank', 'width=1000,height=750');
    
    if (!pageImpression) {
        alert("Veuillez autoriser les fenêtres pop-ups pour imprimer.");
        return;
    }

    const html = `
        <!DOCTYPE html>
        <html lang="fr">
        <head>
            <meta charset="UTF-8">
            <title>Registre des Décharges</title>
            <style>
                /* L'échappement @@ gère la confusion avec le moteur Razor */
                @@page { 
                    margin: 0; 
                }
                
                body { 
                    font-family: 'Segoe UI', Arial, sans-serif; 
                    margin: 0; 
                    padding: 0; 
                    color: #0f172a; 
                    background: #fff; 
                }
                
                h2 { text-align: center; font-size: 18px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #0f172a; padding-bottom: 8px; margin-top: 20px; margin-bottom: 20px; }
                table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                th, td { border: 1px solid #94a3b8; padding: 10px; font-size: 12px; vertical-align: middle; text-align: center; word-wrap: break-word; }
                th { background-color: #f1f5f9; font-weight: bold; color: #334155; }
                
                .no-print { display: none !important; }

                .text-left { text-align: left !important; }
                .col-perso { width: 22%; font-weight: 600; }
                .col-bureau { width: 15%; }
                .col-matr { width: 11%; font-family: monospace; }
                .col-articles { width: 28%; text-align: left; }
                .col-date { width: 12%; font-family: monospace; }
                .col-sign { width: 12%; }
                img { max-height: 40px; max-width: 100%; object-fit: contain; }
                .badge-unsigned { color: #94a3b8; font-style: italic; font-size: 11px; }
            </style>
        </head>
        <body>
            <h2>REGISTRE DES DÉCHARGES MATÉRIELS PAR PERSONNEL</h2>
            ${contenu} </body>
        </html>
    `;

    pageImpression.document.open();
    pageImpression.document.write(html);
    pageImpression.document.close();

    pageImpression.onload = function () {
        pageImpression.focus();
        pageImpression.print();
        pageImpression.close();
    };
}
    function filtrerListe(nom) {
        let searchValue = nom.toLowerCase().trim();
        $(".dechargeRow").each(function () {
            let personnelName = $(this).data("personnel");
            if (personnelName.includes(searchValue) || searchValue === "") {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    }

    $(document).ready(function () {
        $("#PersonnelNom").focus();

        const initialNom = $("#PersonnelNom").val().trim();
        if (initialNom !== "") filtrerListe(initialNom);

        $("#PersonnelNom").keyup(function () {
            let query = $(this).val().trim();

            if (query.length >= 2) {
                $.ajax({
                    url: "/Decharge/SearchPersonnel",
                    type: "GET",
                    data: { search: query },
                    success: function (data) {
                        let suggestions = $("#suggestions");
                        suggestions.empty();
                        let matchExact = false;

                        if (data.length > 0) {
                            suggestions.show();
                            data.forEach(function (personnel) {
                                let affichage = $.isNumeric(query) ? personnel.matricule : personnel.nom;

                                if (affichage.toLowerCase().trim() === query.toLowerCase()) {
                                    matchExact = true;
                                }

                                suggestions.append(
                                    '<a href="#" class="suggestion-item" data-name="' + personnel.nom + '">' + affichage + '</a>'
                                );
                            });
                        } else {
                            suggestions.show();
                            suggestions.append('<div class="suggestion-empty">Aucun personnel trouvé</div>');
                        }

                        if (matchExact) {
                            suggestions.hide().empty();
                            filtrerListe(query);
                        }
                    }
                });
            } else {
                $("#suggestions").hide().empty();
                filtrerListe(query);
            }
        });

        $(document).on("click", ".suggestion-item", function (e) {
            e.preventDefault();
            let selectedName = $(this).data("name");
            $("#PersonnelNom").val(selectedName);
            $("#suggestions").hide().empty();
            filtrerListe(selectedName);
        });

        $(document).click(function (e) {
            if (!$(e.target).closest("#PersonnelNom, #suggestions").length) {
                $("#suggestions").hide().empty();
            }
        });
    });
</script>