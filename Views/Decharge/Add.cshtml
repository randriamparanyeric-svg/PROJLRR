@model PROJLRR.Models.MultiDechargeViewModel

@{
    Layout = "/Views/Shared/Layout.cshtml";
    ViewData["Title"] = "Nouvelle Décharge";
}

<link rel="stylesheet" href="~/css/stylecanva.css" />
<link rel="stylesheet" href="~/css/select2.min.css" />

<style>
    /* Empêche le dédoublement fâcheux lors de l'initialisation Select2 */
    select.select2-hidden-accessible {
        display: none !important;
        opacity: 0 !important;
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        overflow: hidden !important;
    }

    .select2-container--default .select2-selection--single {
        height: 38px;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 36px;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">@ViewData["Title"]</h2>

    <button type="button"
            id="btn-paste-decharge"
            class="btn btn-warning shadow-sm">
        <i class="fas fa-paste"></i>
        Coller une décharge
    </button>
</div>
    <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

    <form method="post" asp-action="Add" id="dechargeForm">

        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="form-group position-relative">
                    <label for="PersonnelNom" class="form-label fw-bold">Nom du Personnel</label>
                    <input type="text" class="form-control form-control-lg" id="PersonnelNom" name="PersonnelNom"
                           required autocomplete="off" value="@Model?.PersonnelNom" placeholder="Saisissez un nom ou un matricule..." />
                    <div id="suggestions" class="list-group shadow" style="position: absolute; z-index: 1000; width: 100%;"></div>
                </div>

                <div id="historique-personnel" class="mt-3" style="display:none;">
                    <div class="card border-info">
                        <div class="card-header bg-info text-white py-1 px-2" style="font-size: 0.9em;">
                            <strong>Dernières décharges effectuées :</strong>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-striped mb-0" style="font-size: 0.85em;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Article</th>
                                        <th>Quantité</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody id="historique-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h4 class="card-title mb-3">Articles à décharger</h4>
                <div id="articles-container">
                   <div class="article-row row g-2 align-items-center mb-2">
    <input type="hidden"
           name="Articles.Index"
           value="0" />

    <div class="col-12 col-sm-6">
        <select class="form-control article-select"
                name="Articles[0].ArticleNom"
                required>
            <option value="">Chargement de la liste d'inventaire...</option>
        </select>
    </div>

    <div class="col-4 col-sm-2">
        <input type="number"
               class="form-control qty-input"
               name="Articles[0].Quantite"
               value="1"
               min="1"
               required
               placeholder="Qté" />
    </div>

    <div class="col-4 col-sm-2">
        <input type="text"
               class="form-control bg-light"
               name="Articles[0].Unite"
               readonly
               placeholder="Unité" />
    </div>

    <div class="col-4 col-sm-2 text-center">
        <button type="button"
                class="btn btn-danger remove-article w-100">
            Suppr.
        </button>
    </div>
</div>                </div>
                <button type="button" id="add-article" class="btn btn-outline-secondary btn-sm mt-2" disabled>Initialisation...</button>
            </div>
        </div>

        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <label for="DateDecharge" class="form-label fw-bold">Date et Heure de l'opération</label>
                <input type="datetime-local" class="form-control" id="DateDecharge" name="DateDecharge"
                       value="@(Model?.DateDecharge == default ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm") : Model.DateDecharge.ToString("yyyy-MM-ddTHH:mm"))" required />
            </div>
        </div>

        <div class="card mb-4 shadow-sm">
            <div class="card-body d-flex flex-column align-items-center text-center">
                
                <label class="form-label fw-bold mb-3">Validation & Signature</label>
                
                <div class="form-group mb-3" style="max-width: 400px; width: 100%;">
                    <label for="Matricule" class="text-muted d-block mb-1" style="font-size: 0.85em; font-weight: 500;">
                        Optionnel : Entrez votre matricule pour charger votre signature existante
                    </label>
                    <input type="text" class="form-control text-center" id="Matricule" name="Matricule" value="@Model?.Matricule" placeholder="Ex: 321456" autocomplete="off" />
                </div>

                <div class="signature-wrapper" style="max-width: 400px; width: 100%;">
                    <div class="border rounded bg-white position-relative mx-auto" style="width: 400px; height: 200px; overflow: hidden;">
                        
                        <canvas id="signature-pad" width="400" height="200" style="position: absolute; top:0; left:0; z-index: 1;"></canvas>
                        
                        <img id="signature-preview" src="" alt="Aperçu signature bdd" 
                             style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; background: rgba(240, 253, 244, 0.96); z-index: 5; border: 2px solid #22c55e;" />
                    </div>
                    
                    <div class="mt-2">
                        <button type="button" id="clear-signature" class="btn btn-sm btn-outline-success">Effacer / Dessiner manuellement</button>
                    </div>
                </div>
                
            </div>
        </div>
        <input type="hidden" id="SignatureData" name="SignatureData" />

        <div class="text-center mt-4 mb-5">
            <button type="submit" class="btn btn-primary btn-lg px-5 mb-3 shadow">Enregistrer la décharge</button>
            <div class="d-flex justify-content-center gap-2">
                <a href="@Url.Action("IndexBis", "Decharge")" class="btn btn-outline-secondary btn-sm">Décharges du jour</a>
                <a href="@Url.Action("Index", "Decharge")" class="btn btn-outline-secondary btn-sm">Toutes les décharges</a>
            </div>
        </div>
    </form>
</div>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/select2.min.js"></script>
<script src="~/js/sweetalert2.all.min.js"></script>
<script src="~/js/signature_pad.min.js"></script>

<script>
$(document).ready(function () {
    
    // --- 1. BOÎTES MODALES SWEETALERT2 ---
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        Swal.fire({
            icon: 'success',
            title: '<span style="color: #166534;">Réussi</span>',
            html: '<b style="color: #14532d; font-size: 1.1rem;">@Html.Raw(TempData["SuccessMessage"])</b>', 
            background: '#f0fdf4', 
            iconColor: '#22c55e',
            timer: 2300,
            timerProgressBar: true,
            showConfirmButton: false,
            customClass: { popup: 'rounded-4 shadow border border-success' }
        });
        </text>
    }

    // --- 2. LOGIQUE DYNAMIQUE DES ARTICLES ---
    let ensembleArticles = []; 

    function chargerHistoriqueRecents(nomPersonnel) {
        if (!nomPersonnel || nomPersonnel.length < 2) { 
            $("#historique-personnel").hide(); 
            return; 
        }
        $.ajax({
            url: "/Decharge/GetDerniereDechargePersonnel",
            type: "GET",
            data: { nom: nomPersonnel },
            success: function (donnees) {
                let tableauBody = $("#historique-body").empty();
                if (donnees && donnees.length > 0) {
                    donnees.forEach(x => {
                        tableauBody.append(`<tr><td>${x.article}</td><td>${x.quantite} ${x.unite}</td><td>${x.date}</td></tr>`);
                    });
                    $("#historique-personnel").fadeIn();
                } else { 
                    $("#historique-personnel").hide(); 
                }
            }
        });
    }

    // 🔥 FONCTION CORRIGÉE ET SÉCURISÉE POUR PC & FOCUS
   function hydraterSelectDArticle(selectCible) {
    if (selectCible.hasClass("select2-hidden-accessible")) {
        selectCible.select2("destroy");
    }
    
    selectCible.next('.select2-container').remove();
    selectCible.empty().append('<option value="">Rechercher un article...</option>');
    
    ensembleArticles.forEach(function (art) {
        let texteLabel = art.nom + ' (' + art.quantite + ' ' + art.unite + ')';
        selectCible.append(`<option value="${art.nom}" data-unite="${art.unite}">${texteLabel}</option>`);
    });
    
    selectCible.select2({
        width: '100%',
        placeholder: "Rechercher un article..."
    });

    // 🔥 LE CORRECTIF ANTI-ALÉATOIRE POUR PC
    selectCible.on('select2:open', function () {
        setTimeout(function () {
            // On cherche l'input de recherche dans le container qui vient de s'ouvrir
            const searchField = document.querySelector('.select2-container--open .select2-search__field');
            if (searchField) {
                searchField.focus(); // Focus JavaScript natif (plus robuste que jQuery sur PC)
            }
        }, 150); // 150ms laisse le temps à l'animation PC de se terminer proprement
    });
}

    // Chargement initial du catalogue
    $.ajax({
        url: "/Decharge/GetArt",
        type: "GET",
        success: function (resultat) {
            ensembleArticles = resultat;
            hydraterSelectDArticle($(".article-select").first());
            $("#add-article").prop('disabled', false).text("+ Ajouter un article");
        },
        error: function() {
            $("#add-article").text("Erreur réseau");
        }
    });

    let indexCompteur = 1;
   function ajouterLigneArticle(nomArticle, quantite, unite) {
    const index = indexCompteur;

    const structureLigne = `
        <div class="article-row row g-2 align-items-center mb-2">
            <input type="hidden"
                   name="Articles.Index"
                   value="${index}" />

            <div class="col-12 col-sm-6">
                <select class="form-control article-select"
                        name="Articles[${index}].ArticleNom"
                        required>
                </select>
            </div>

            <div class="col-4 col-sm-2">
                <input type="number"
                       class="form-control qty-input"
                       name="Articles[${index}].Quantite"
                       value="${quantite || 1}"
                       min="1"
                       required />
            </div>

            <div class="col-4 col-sm-2">
                <input type="text"
                       class="form-control bg-light"
                       name="Articles[${index}].Unite"
                       value="${unite || ""}"
                       readonly />
            </div>

            <div class="col-4 col-sm-2 text-center">
                <button type="button"
                        class="btn btn-danger remove-article w-100">
                    Suppr.
                </button>
            </div>
        </div>`;

    const $nouvelleLigne = $(structureLigne);

    $("#articles-container").append($nouvelleLigne);

    const $select = $nouvelleLigne.find(".article-select");

    hydraterSelectDArticle($select);

    // Sélectionner l'article après le chargement du catalogue.
    if (nomArticle) {
        $select.val(nomArticle).trigger("change");
    }

    if (unite) {
        $nouvelleLigne
            .find("input[name$='.Unite']")
            .val(unite);
    }

    indexCompteur++;
}

$("#add-article").click(function () {
    ajouterLigneArticle("", 1, "");
});

// ======================================================
// COLLER UNE DÉCHARGE
// ======================================================
$("#btn-paste-decharge").on("click", function () {
    const donneesCopiees = sessionStorage.getItem("dechargeACopier");

    if (!donneesCopiees) {
        Swal.fire({
            icon: "info",
            title: "Aucune décharge copiée",
            text: "Veuillez d'abord copier une décharge depuis la page Modifier."
        });

        return;
    }

    let decharge;

    try {
        decharge = JSON.parse(donneesCopiees);
    }
    catch (erreur) {
        sessionStorage.removeItem("dechargeACopier");

        Swal.fire({
            icon: "error",
            title: "Erreur",
            text: "Les données copiées sont invalides."
        });

        return;
    }

    if (!decharge.success || !Array.isArray(decharge.articles)) {
        Swal.fire({
            icon: "error",
            title: "Erreur",
            text: "La décharge copiée ne contient aucun article."
        });

        return;
    }

    if (decharge.articles.length === 0) {
        Swal.fire({
            icon: "warning",
            title: "Aucun article",
            text: "La décharge copiée ne contient aucun article."
        });

        return;
    }

    Swal.fire({
        icon: "question",
        title: "Coller la décharge ?",
        html:
            "Les articles de la décharge de <b>" +
            (decharge.personnelSource || "l'agent source") +
            "</b> seront ajoutés au formulaire.<br><br>" +
            "Vous devrez ensuite sélectionner le nouveau personnel.",
        showCancelButton: true,
        confirmButtonText: "Oui, coller",
        cancelButtonText: "Annuler",
        confirmButtonColor: "#f0ad4e"
    }).then(function (confirmation) {
        if (!confirmation.isConfirmed) {
            return;
        }

        // On ne copie pas l'ancien nom.
        // L'utilisateur peut sélectionner ou saisir le nouveau personnel.
        $("#PersonnelNom").val("");

        // On supprime les lignes présentes dans le formulaire.
        $("#articles-container").empty();

        // On recommence les index à zéro.
        indexCompteur = 0;

        // Ajout des articles copiés.
        decharge.articles.forEach(function (article) {
            ajouterLigneArticle(
                article.articleNom,
                article.quantite,
                article.unite
            );
        });

        // Une nouvelle décharge doit avoir une nouvelle date.
        const maintenant = new Date();
        const annee = maintenant.getFullYear();
        const mois = String(maintenant.getMonth() + 1).padStart(2, "0");
        const jour = String(maintenant.getDate()).padStart(2, "0");
        const heures = String(maintenant.getHours()).padStart(2, "0");
        const minutes = String(maintenant.getMinutes()).padStart(2, "0");

        $("#DateDecharge").val(
            `${annee}-${mois}-${jour}T${heures}:${minutes}`
        );

        // On ne réutilise pas automatiquement la signature de l'autre personne.
        $("#Matricule").val("");
        $("#signature-preview").hide().attr("src", "");

        if (typeof signaturePadEngine !== "undefined") {
            signaturePadEngine.clear();
        }

        // Suppression après utilisation pour éviter une nouvelle copie involontaire.
        sessionStorage.removeItem("dechargeACopier");

        Swal.fire({
            icon: "success",
            title: "Décharge collée",
            text: "Vérifiez le personnel, puis ajoutez la signature du nouveau bénéficiaire.",
            confirmButtonColor: "#198754"
        });
    });
});

    $(document).on("click", ".remove-article", function () {
        $(this).closest(".article-row").remove();
    });

    $(document).on("change", ".article-select", function () {
        let uniteMesure = $(this).find(":selected").data("unite") || "";
        $(this).closest(".article-row").find("input[name$='.Unite']").val(uniteMesure);
    });

    // --- 3. AUTOCOMPLÉTION DU PERSONNEL ---
    $("#PersonnelNom").keyup(function () {
        let saisie = $(this).val().trim();
        if (saisie.length >= 2) {  
            $.ajax({
                url: "/Decharge/SearchPersonnel",
                type: "GET",
                data: { search: saisie },
                success: function (reponse) {
                    let conteneurSuggestions = $("#suggestions").empty();
                    reponse.forEach(p => {
                        let texteAAfficher = $.isNumeric(saisie) ? p.matricule : p.nom;
                        conteneurSuggestions.append(`<a href="#" class="list-group-item list-group-item-action item-de-suggestion" data-name="${p.nom}">${texteAAfficher}</a>`);
                    });
                }
            });
        } else { 
            $("#suggestions").empty(); 
            $("#historique-personnel").hide(); 
        }
    });

    $(document).on("click", ".item-de-suggestion", function (e) {
        e.preventDefault();
        let nomRetenu = $(this).data("name");
        $("#PersonnelNom").val(nomRetenu);  
        $("#suggestions").empty();
        chargerHistoriqueRecents(nomRetenu);
        
        if ($("#Matricule").val().trim() !== "") {
            $("#Matricule").trigger("blur");
        }
    });

    let verifNomInitial = $("#PersonnelNom").val().trim();
    if(verifNomInitial.length >= 2) {
        chargerHistoriqueRecents(verifNomInitial);
    }

    // --- 4. ENGINE DE SIGNATURES ET APERÇU ---
    var canvasElement = document.getElementById("signature-pad");
    window.signaturePadEngine = new SignaturePad(canvasElement);

    // Événement d'interrogation AJAX de la signature précédente
    $("#Matricule").on("blur", function () {
        let mtr = $(this).val().trim();
        let nom = $("#PersonnelNom").val().trim();

        if (mtr === "") {
            $("#signature-preview").hide().attr("src", "");
            return;
        }

        if (nom === "") {
            Swal.fire({
                icon: 'info',
                title: 'Information',
                text: 'Veuillez d\'abord sélectionner ou écrire le nom complet de l\'agent avant de lier le matricule.'
            });
            return;
        }

        $.ajax({
            url: "/Decharge/GetSignaturePrecedente",
            type: "GET",
            data: { nom: nom, matricule: mtr },
            success: function (resultatJson) {
                if (resultatJson.success) {
                    $("#signature-preview").attr("src", resultatJson.path).fadeIn();
                   window.signaturePadEngine.clear();
                } else {
                    $("#signature-preview").hide().attr("src", "");
                    Swal.fire({
                        icon: 'warning',
                        title: 'Signature introuvable',
                        text: resultatJson.message
                    });
                }
            },
            error: function () {
                console.error("Impossible de joindre le service de synchronisation des images.");
            }
        });
    });

    // Reset complet de la zone
    $("#clear-signature").click(function () {
        signaturePadEngine.clear();
        $("#Matricule").val(""); 
        $("#signature-preview").fadeOut().attr("src", ""); 
    });

    // --- 5. INTERCEPTION SÉCURISÉE AVANT ENVOI FORMULAIRE ---
    $("#dechargeForm").submit(function(e){
        let estCalqueApercuVisible = $("#signature-preview").is(":visible");

        if (window.signaturePadEngine.isEmpty() && !estCalqueApercuVisible) {
            Swal.fire({
                icon: 'warning',
                title: 'Validation bloquée',
                text: 'Une signature manuscrite est requise, ou entrez un matricule valide pour récupérer votre historique.',
                confirmButtonColor: '#0284c7'
            });
            e.preventDefault();
        } 
        else if (!window.signaturePadEngine.isEmpty()) {
            $("#SignatureData").val(signaturePadEngine.toDataURL());
        }
    });
});
</script>